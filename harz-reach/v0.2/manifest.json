{
  "manifest_version": 3,
  "name": "HARZ Reach",
  "version": "0.2.0",
  "description": "Resolve .harz names through the signed HARZ root. Many nodes, one signed book, one king. Zero DNS settings, local signature verification, honest answers.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://harz-root.harz.workers.dev/*",
    "*://*.harz/*",
    "http://*.harz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HARZ Reach"
  }
}