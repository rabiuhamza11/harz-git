ument.getElementById('projPrivate').value === 'true';\nconst autoDeploy = document.getElementById('projAutoDeploy').value === 'true';\nconst platforms = getSelectedPlatforms();\n\nif (!name) { showToast('⚠️ Project name is required', 'error'); return; }\nif (!platforms.length) { showToast('⚠️ Select at least one platform', 'error'); return; }\n\nlet envVars = {};\ntry { if (envVarsRaw) envVars = JSON.parse(envVarsRaw); }\ncatch { showToast('⚠️ Invalid JSON in env vars', 'error'); return; }\n\n// Show log section\ndocument.getElementById('deployLogSection').style.display = 'block';\nclearLog();\naddLog('info', '🚀 Starting deployment pipeline...');\naddLog('', `Project: ${name} | Framework: ${framework} | Platforms: ${platforms.join(', ')}`);\n\n// Try API first, fall back to simulation\ntry {\naddLog('info', '📡 Calling DeployForge API...');\n\nconst body = {\nprojectName: name,\nframework,\ndescription: desc,\nenvVars,\nisPrivate,\nautoDeploy,\nplatforms,\n};\n\nlet response;\nif (platforms.includes('github') && platforms.includes('vercel')) {\n// Full pipeline\nresponse = await fetch(`${API_BASE}/api/deployforgeLaunch`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify(body),\n});\n} else if (platforms.includes('github')) {\nresponse = await fetch(`${API_BASE}/api/deployforgeGitHub`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'createRepo', repoName: name, description: desc, isPrivate }),\n});\n} else if (platforms.includes('vercel')) {\nresponse = await fetch(`${API_BASE}/api/deployforgeVercel`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'createProject', projectName: name, framework }),\n});\n}\n\nif (response && response.ok) {\nconst result = await response.json();\naddLog('success', '✅ Deployment successful!');\nif (result.github) addLog('success', `🐙 GitHub: ${result.github.url}`);\nif (result.vercel) addLog('success', `▲ Vercel: ${result.vercel.url}`);\nshowToast('✅ Deployed successfully!', 'success');\n// Add to history\nSAMPLE_DEPLOYS.unshift({\nid: Date.now(),\nproject: name,\nframework,\nstatus: 'live',\ngithub: 'pushed',\nvercel: 'ready',\nurl: `${name}.vercel.app`,\ndate: new Date().toISOString().slice(0, 16).replace('T', ' '),\n});\nupdateStats(SAMPLE_DEPLOYS);\nrenderHistory(SAMPLE_DEPLOYS);\n} else {\nthrow new Error('API not available');\n}\n} catch (err) {\naddLog('error', `⚠️ API unavailable: ${err.message}`);\naddLog('info', '📝 Simulating deployment pipeline...');\n\n// Simulate deployment steps\nconst steps = [\n{ delay: 500, msg: '🔐 Authenticating with GitHub...', type: 'info' },\n{ delay: 800, msg: '🐙 Creating GitHub repository...', type: '' },\n{ delay: 600, msg: '📦 Pushing code to GitHub...', type: '' },\n{ delay: 500, msg: '✅ GitHub: repo created & code pushed', type: 'success' },\n{ delay: 700, msg: '▲ Creating Vercel project...', type: 'info' },\n{ delay: 800, msg: '🔧 Setting environment variables...', type: '' },\n{ delay: 600, msg: '🚀 Triggering Vercel deployment...', type: '' },\n{ delay: 1000, msg: '✅ Vercel: project deployed & live', type: 'success' },\n{ delay: 300, msg: '💾 Saving deployment record...', type: '' },\n{ delay: 200, msg: '🎉 Deployment complete!', type: 'success' },\n];\n\nfor (const step of steps) {\nawait new Promise(r => setTimeout(r, step.delay));\naddLog(step.type, step.msg);\n}\n\naddLog('success', `🌐 Live URL: https://${name}.vercel.app`);\n\n// Add to history\nSAMPLE_DEPLOYS.unshift({\nid: Date.now(),\nproject: name,\nframework,\nstatus: 'live',\ngithub: 'pushed',\nvercel: 'ready',\nurl: `${name}.vercel.app`,\ndate: new Date().toISOString().slice(0, 16).replace('T', ' '),\n});\nupdateStats(SAMPLE_DEPLOYS);\nrenderHistory(SAMPLE_DEPLOYS);\nshowToast('✅ Deployment simulated! (API will be live when deployed)', 'success');\n}\n}\n\n// ===== Logging =====\nfunction addLog(type, msg) {\nconst log = document.getElementById('deployLog');\nconst time = new Date().toLocaleTimeString('en-US', { hour12: false });\nconst entry = document.createElement('div');\nentry.className = `log-entry ${type}`;\nentry.innerHTML = `<span class=\"log-time\">[${time}]<\/span> ${msg}`;\nlog.appendChild(entry);\nlog.scrollTop = log.scrollHeight;\n}\n\nfunction clearLog() {\ndocument.getElementById('deployLog').innerHTML = '';\n}\n\nfunction resetForm() {\ndocument.getElementById('projName').value = '';\ndocument.getElementById('projDesc').value = '';\ndocument.getElementById('projEnvVars').value = '';\ndocument.querySelectorAll('.chip').forEach(c => {\nif (c.dataset.platform === 'github' || c.dataset.platform === 'vercel') {\nc.classList.add('active');\n} else {\nc.classList.remove('active');\n}\n});\n}\n\n// ===== Toast =====\nfunction showToast(msg, type = 'success') {\nconst toast = document.getElementById('toast');\ndocument.getElementById('toastMsg').textContent = msg;\ndocument.getElementById('toastIcon').textContent = type === 'success' ? '✅' : '⚠️';\ntoast.className = 'toast show ' + type;\nsetTimeout(() => toast.classList.remove('show'), 3000);\n}\n\n// ===== Refresh Functions =====\nasync function refreshPlatforms() {\nshowToast('↻ Refreshing platforms...');\nrenderPlatforms();\n}\n\nasync function refreshRepos() {\nshowToast('↻ Refreshing repos...');\ntry {\nconst resp = await fetch(`${API_BASE}/api/deployforgeAdmin`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'stats' }),\n});\nif (resp.ok) {\nconst data = await resp.json();\nif (data.github?.repos?.length) {\nSAMPLE_REPOS = data.github.repos.map(r => ({ name: r.name, lang: r.language || '—', url: r.url, updated: r.updated?.slice(0,10) || '—' }));\nrenderRepos();\nshowToast('✅ Repos refreshed from GitHub!');\nreturn;\n}\n}\n} catch {}\nrenderRepos();\n}\n\nasync function refreshVercel() {\nshowToast('↻ Refreshing Vercel...');\ntry {\nconst resp = await fetch(`${API_BASE}/api/deployforgeAdmin`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'stats' }),\n});\nif (resp.ok) {\nconst data = await resp.json();\nif (data.vercel?.projects?.length) {\nSAMPLE_VERCEL = data.vercel.projects.map(p => ({ name: p.name, framework: p.framework || '—', url: p.url }));\nrenderVercel();\nshowToast('✅ Vercel projects refreshed!');\nreturn;\n}\n}\n} catch {}\nrenderVercel();\n}\n\nasync function refreshHistory() {\nshowToast('↻ Refreshing history...');\ntry {\nconst resp = await fetch(`${API_BASE}/api/deployforgeAdmin`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'list' }),\n});\nif (resp.ok) {\nconst data = await resp.json();\nif (data.tasks?.length) {\nconst mapped = data.tasks.map(t => ({\nid: t.id, project: t.project_name, framework: t.framework,\nstatus: t.deploy_status, github: t.github_status, vercel: t.vercel_status,\nurl: t.live_url || t.vercel_url || '', date: t.created_date?.slice(0,16).replace('T',' ') || '—',\n}));\nrenderHistory(mapped);\nupdateStats(mapped);\nshowToast('✅ History refreshed!');\nreturn;\n}\n}\n} catch {}\nrenderHistory(SAMPLE_DEPLOYS);\nupdateStats(SAMPLE_DEPLOYS);\n}\n\n// ===== Init =====\nrenderPlatforms();\nrenderRepos();\nrenderVercel();\nrenderHistory(SAMPLE_DEPLOYS);\nupdateStats(SAMPLE_DEPLOYS);\n<\/script>\n<\/body>\n<\/html>\n"},{"name":"Harz Cloud","domain":"harz-cloud.pages.dev","url":"https://harz-cloud.pages.dev","status":"live","title":"DeployForge — HARZ Deployment Engine","fetched_at":"2026-10-08T06:49:04Z","size":27781,"html_sha256":"678ce21330f426fdf2acdc87601e6d99e7e4497a43bc5ac0929c5b2df56985f5","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>DeployForge — HARZ Deployment Engine<\/title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\n:root{\n--bg:#0a0b14;--card:#13151f;--card-hover:#1a1d2e;--border