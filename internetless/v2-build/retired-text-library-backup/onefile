Sessions().length){const s=getSessions()[0];localStorage.setItem('harzmail',s.token+'|'+s.addr)}else{localStorage.removeItem('harzmail')}location.reload()}\nfunction openSettings(){document.getElementById('list').style.display='none';document.getElementById('openview').style.display='none';document.getElementById('composeview').style.display='none';document.getElementById('accountsview').style.display='none';document.getElementById('settingsview').style.display='block';loadSettings()}\nasync function loadSettings(){const r=await api('/api/me');document.getElementById('s_rec').value=r.recovery_addr||''}\nfunction closeSettings(){document.getElementById('settingsview').style.display='none';document.getElementById('list').style.display='block'}\nasync function changePass(){const np=document.getElementById('s_new').value;if(np!==document.getElementById('s_new2').value){alert('New passwords do not match');return}const r=await api('/api/setpass',{current:document.getElementById('s_cur').value,newpass:np});if(!r.success){alert(r.error);return}alert('Password changed');document.getElementById('s_cur').value='';document.getElementById('s_new').value='';document.getElementById('s_new2').value=''}\nasync function saveRecovery(){const r=await api('/api/settings',{recovery:document.getElementById('s_rec').value,current:document.getElementById('s_recpass').value});if(!r.success){alert(r.error);return}alert('Recovery address saved');document.getElementById('s_recpass').value=''}\nfunction renderTabs(unread){document.getElementById('tabs').innerHTML=FOLDERS.map(([f,l])=>'<div class=\"tab'+(f===FOLDER?' on':'')+'\" onclick=\"go(\\''+f+'\\')\">'+l+(f==='inbox'&&unread?'<span class=\"badge\">'+unread+'<\/span>':'')+'<\/div>').join('')}\nasync function go(f){FOLDER=f;renderTabs(await getUnread());await loadList()}\nasync function getUnread(){const r=await api('/api/me');return r.unread||0}\nasync function loadList(){document.getElementById('openview').style.display='none';document.getElementById('composeview').style.display='none';const r=await api('/api/list?folder='+FOLDER);MSGS=r.messages||[];renderList()}\nfunction renderList(){const q=document.getElementById('q').value.toLowerCase();const ms=MSGS.filter(m=>!q||(m.from+m.to+m.subject+m.snippet).toLowerCase().includes(q));document.getElementById('list').innerHTML=ms.length?ms.map(m=>'<div class=\"card'+(m.folder==='inbox'&&!m.read?' unread':'')+'\" onclick=\"openMsg(\\''+m.id+'\\')\"><div class=\"who\"><span class=\"st'+(m.starred?' on':'')+'\" onclick=\"event.stopPropagation();star(\\''+m.id+'\\')\">★<\/span><b>'+esc(FOLDER==='sent'||FOLDER==='drafts'?m.to:m.from)+'<\/b><span style=\"margin-left:auto\">'+ago(m.ts)+'<\/span><\/div><div class=\"subj\">'+esc(m.subject||'(no subject)')+'<\/div><div class=\"snip\">'+esc(m.snippet)+'<\/div><\/div>').join(''):'<div class=\"empty\">No mail here yet<\/div>'}\nasync function openMsg(id){const r=await api('/api/open',{id});if(!r.success)return;const m=r.message;MSGS=MSGS.map(x=>x.id===id?{...x,read:true}:x);document.getElementById('list').style.display='none';document.getElementById('openview').style.display='block';document.getElementById('openview').innerHTML='<h2>'+esc(m.subject||'(no subject)')+'<\/h2><div class=\"meta\">From <b>'+esc(m.from)+'<\/b> to <b>'+esc(m.to)+'<\/b> · '+new Date(m.ts).toLocaleString()+'<\/div><div class=\"body\">'+esc(m.body)+'<\/div><div class=\"row\"><button class=\"pri\" onclick=\"replyTo(\\''+m.id+'\\')\">Reply<\/button><button class=\"sec\" onclick=\"star(\\''+m.id+'\\',true)\">★ Star<\/button><button class=\"sec\" onclick=\"trashMsg(\\''+m.id+'\\')\">🗑 Trash<\/button><\/div>';renderTabs(await getUnread())}\nasync function star(id,on){await api('/api/star',{id,on:on===undefined?true:on});await loadList()}\nasync function trashMsg(id){await api('/api/trash',{id});await loadList()}\nfunction showList(){document.getElementById('list').style.display='block';document.getElementById('openview').style.display='none';document.getElementById('composeview').style.display='none'}\nfunction openCompose(pre){showList();document.getElementById('composeview').style.display='block';DRAFT=null;document.getElementById('c_to').value=pre||'';document.getElementById('c_subj').value='';document.getElementById('c_body').value=''}\nasync function replyTo(id){const m=MSGS.find(x=>x.id===id);openCompose(m?m.from:'');if(m)document.getElementById('c_subj').value=(m.subject||'').startsWith('Re:')?m.subject:'Re: '+(m.subject||'')}\nasync function closeCompose(){showList()}\nasync function sendMail(){const r=await api('/api/send',{to:document.getElementById('c_to').value,subject:document.getElementById('c_subj').value,body:document.getElementById('c_body').value,draft_id:DRAFT});if(!r.success){alert(r.error);return}alert('Delivered on @mail.harz');showList();await go(FOLDER)}\nasync function saveDraft(){const r=await api('/api/draft',{to:document.getElementById('c_to').value,subject:document.getElementById('c_subj').value,body:document.getElementById('c_body').value,draft_id:DRAFT});if(r.success){DRAFT=r.draft_id;alert('Draft saved')}}\nasync function boot(){renderTabs(await getUnread());await loadList()}\nconst saved=localStorage.getItem('harzmail');if(saved){const[t,a]=saved.split('|');TOKEN=t;ADDR=a;enterApp()}\nif('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(function(){})}\n<\/script>\n<\/body>\n<\/html>"},{"name":"Harz Merchant Portal","domain":"harz-merchant-portal.hamzarabiu390.workers.dev","url":"https://harz-merchant-portal.hamzarabiu390.workers.dev","status":"live","title":"HARZ Merchant Portal","fetched_at":"2026-10-08T06:49:04Z","size":17867,"html_sha256":"b6fcf77bb65bad7a5c0d6e4f1101266286184ed8a8a54e71c21258fca6bef3cc","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"theme-color\" content=\"#0a7d3c\">\n<title>HARZ Merchant Portal<\/title>\n<link rel=\"manifest\" href=\"/manifest.json\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,sans-serif}\nbody{background:#f0f2f5;color:#1a1a2e}\n.header{background:#0a7d3c;color:#fff;padding:14px 20px;position:sticky;top:0;z-index:100}\n.header h1{font-size:18px}.header .sub{font-size:11px;opacity:0.8}\n.container{max-width:600px;margin:0 auto;padding:14px;padding-bottom:70px}\n.card{background:#fff;border-radius:12px;padding:14px;margin-bottom:10px;box-shadow:0 1px 3px rgba(0,0,0,.08)}\n.card h2{font-size:15px;color:#0a7d3c;margin-bottom:8px}\n.card p{font-size:13px;color:#555;line-height:1.5}\n.stat{display:inline-block;text-align:center;padding:10px;background:#f8f9fa;border-radius:8px;margin:4px;min-width:75px}\n.stat .num{font-size:20px;font-weight:700;color:#0a7d3c}\n.stat .num.red{color:#ef4444}.stat .num.amber{color:#f59e0b}\n.stat .lbl{font-size:10px;color:#888}\ninput,select,textarea{width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:14px;margin-bottom:8px;background:#fff}\n.label{font-size:12px;font-weight:600;color:#555;margin-bottom:3px;display:block}\n.btn{display:block;width:100%;padding:12px;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;text-align:center}\n.btn-primary{background:#0a7d3c;color:#fff}.btn-sec{background:#e8f5e9;color:#0a7d3c;border:1px solid #0a7d3c}\n.btn-sm{padding:8px;font-size:13px;border-radius:8px;width:auto;display:inline-block}\n.tag{display:inline-block;padding:2px 8px;border-radius:12px;font-size:10px;font-weight:600}\n.tag.green{background:#dcfce7;color:#16a34a}.tag.amber{background:#fef3c7;color:#d97706}.tag.red{background:#fee2e2;color:#dc2626}.tag.blue{background:#dbeafe;color:#2563eb}\n.nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #e0e0e0;display:flex;max-width:600px;margin:0 auto;z-index:100}\n.nav-item{flex:1;padding:10px 2px;text-align:center;font-size:11px;color:#888;cursor:pointer}\n.nav-item.active{color:#0a7d3c}.nav-item .ic{font-size:18px}\n.section{display:none}.section.active{display:block}\n.chat{max-height:300px;overflow-y:auto;margin-bottom:10px}\n.chat-msg{padding:8px 12px;border-radius:10px;margin-bottom:6px;font-size:13px;max-width:85%}\n.chat-msg.bot{background:#e8f5e9;border-radius:10px 10px 10px 0}\n.chat-msg.user{background:#dbeafe;margin-left:auto;border-radius:10px 10px 0 10px}\n.toast{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);background:#1a1a2e;color:#fff;padding:10px 20px;border-radius:8px;font-size:13px;z-index:200;opacity:0;transition:.3s}\n.toast.show{opacity:1}\n.progress{height:4px;background:#e0e0e0;border-radius:2px;margin:8px 0}\n.progress-bar{height:100%;background:#0a7d3c;border-radius:2px;transition:.3s}\n.step{display:flex;align-items:center;padding:8px 0;border-bottom:1px solid #f0f0f0}\n.step-num{width:24px;height:24px;border-radius:50%;background:#0a7d3c;color:#fff;text-align:center;line-height:24px;font-size:12px;margin-right:10px;flex-shrink:0}\n.step.done .step-num{background:#16a34a}.step.pending .step-num{background:#d1d5db}\n.step-text{font-size:13px}.step.done .step-text{color:#666}\n<\/style>\n<\/head>\n<body>\n<div class=\"header\"><h1>HARZ Merchant Portal<\/h1><div class=\"sub\">Autonomous Commerce for African SMEs<\/div><\/div>\n<div class=\"container\">\n\n<!-- LANDING / ONBOARDING -->\n<div id=\"landingSection\" class=\"section active\" data-ref=\"\">\n<div class=\"card\" style=\"text-align:center;padding:20px\">\n<h2 style=\"font-size:18px;margin-bottom:6px\">Start Selling with AI<\/h2>\n<p style=\"margin-bottom:14px\">Get an AI sales agent that takes orders, collects payments, and manages delivery — all on autopilot.<\/p>\n<button class=\"btn btn-primary\" onclick=\"showSection('onboard')\">Get Started Free<\/button>\n<\/div>\n<div class=\"card\"><h2>How It Works<\/h2>\n<p>1. Tell our AI what you sell<br>2. AI sets up your store instantly<br>3. Customers chat, order, and pay<br>4. AI handles fulfillment automatically<br>5. You track everything from your dashboard<\/p><\/div>\n<div class=\"card\"><h2>Already a Merchant?<\/h2>\n<div class=\"label\">Phone Number<\/div><input type=\"tel\" id=\"loginPhone\" placeholder=\"080XXXXXXXX\">\n<button class=\"btn btn-sec\" onclick=\"loginMerchant()\">Login to Dashboard<\/button>\n<\/div>\n<\/div>\n\n<!-- AI SETUP AGENT -->\n<div id=\"onboardSection\" class=\"section\">\n<div class=\"card\"><h2>AI Store Setup<\/h2><p>Tell me about your business in plain English. I'll set everything up for you.<\/p><\/div>\n<div class=\"card\">\n<div class=\"chat\" id=\"setupChat\">\n<div class=\"chat-msg bot\">Hi! I'm your AI setup assistant. Tell me about your business — what do you sell and where are you located?<\/div>\n<\/div>\n<input type=\"text\" id=\"setupInput\" placeholder=\"e.g. I sell building materials in Abuja\">\n<button class=\"btn btn-primary\" onclick=\"sendSetupMsg()\">Send<\/button>\n<\/div>\n<\/div>\n\n<!-- MERCHANT DASHBOARD / COMMAND CENTER -->\n<div id=\"dashSection\" class=\"section\">\n<div class=\"card\"><div style=\"text-align:center\">\n<div class=\"stat\"><div class=\"num\" id=\"stOrders\">0<\/div><div class=\"lbl\">Orders Today<\/div><\/div>\n<div class=\"stat\"><div class=\"num\" id=\"stRevenue\">0<\/div><div class=\"lbl\">Revenue<\/div><\/div>\n<div class=\"stat\"><div class=\"num amber\" id=\"stPending\">0<\/div><div class=\"lbl\">Pending<\/div><\/div>\n<div class=\"stat\"><div class=\"num red\" id=\"stIssues\">0<\/div><div class=\"lbl\">Issues<\/div><\/div>\n<\/div><\/div>\n<div class=\"card\"><h2>Recent Orders<\/h2><div id=\"dashOrders\" style=\"font-size:13px;color:#999\">Loading...<\/div><\/div>\n<div class=\"card\"><h2>Inventory<\/h2><div id=\"dashInventory\" style=\"font-size:13px;color:#999\">Loading...<\/div><\/div>\n<div class=\"card\"><h2>AI Actions Log<\/h2><div id=\"dashActions\" style=\"font-size:13px;color:#999\">No AI actions yet<\/div><\/div>\n<div class=\"card\"><h2>Earnings<\/h2>\n<div style=\"font-size:13px\">\n<div style=\"display:flex;justify-content:space-between;padding:4px 0\"><span>Gross Revenue:<\/span><strong id=\"earnGross\">N0<\/strong><\/div>\n<div style=\"display:flex;justify-content:space-between;padding:4px 0\"><span>Commission (10%):<\/span><strong id=\"earnComm\">N0<\/strong><\/div>\n<div style=\"display:flex;justify-content:space-between;padding:4px 0\"><span>Delivery Costs:<\/span><strong id=\"earnDel\">N0<\/strong><\/div>\n<div style=\"display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid #eee;margin-top:4px;padding-top:8px\"><span>Net Earnings:<\/span><strong style=\"color:#0a7d3c\" id=\"earnNet\">N0<\/strong><\/div>\n<\/div><\/div>\n<\/div>\n\n<!-- PRODUCTS -->\n<div id=\"productsSection\" class=\"section\">\n<div class=\"card\"><h2>Add Product<\/h2>\n<div class=\"label\">Product Name<\/div><input type=\"text\" id=\"prodName\" placeholder=\"e.g. Cement 50kg\">\n<div class=\"label\">Price (Naira)<\/div><input type=\"number\" id=\"prodPrice\" placeholder=\"7500\">\n<div class=\"label\">Stock Quantity<\/div><input type=\"number\" id=\"prodStock\" placeholder=\"100\">\n<div class=\"label\">Category (optional)<\/div><input type=\"text\" id=\"prodCategory\" placeholder=\"Building Materials\">\n<button class=\"btn btn-primary\" onclick=\"addProduct()\">Add Product<\/button>\n<\/div>\n<div class=\"card\"><h2>Your Products<\/h2><div id=\"productList\" style=\"font-size:13px;color:#999\">No products yet<\/div><\/div>\n<\/div>\n\n<!-- AI SETTINGS -->\n<div id=\"aiSection\" class=\"section\">\n<div class=\"card\"><h2>AI Permissions<\/h2><p style=\"font-size:12px;margin-bottom:8px\">Control what your AI agent can do automatically vs. what needs your approval.<\/p>\n<div id=\"permissionsList\" style=\"font-size:13px\"><\/div><\/div>\n<div class=\"card\"><h2>Store Status<\/h2>\n<div id=\"storeStatus\" style=\"font-size:13px\"><\/div>\n<button class=\"btn btn-sec\" onclick=\"toggleStore()\" id=\"storeToggleBtn\">Loading...<\/button>\n<\/div>\n<\/div>\n\n<!-- TRUST -->\n<div id=\"trustSection\" class=\"section\">\n<div class=\"card\"><h2>Trust Score<\/h2>\n<div style=\"text-align:center;padding:10px\">\n<div style=\"font-size:32px;font-weight:700;color:#0a7d3c\" id=\"trustScore\">--<\/div>\n<div style=\"font-size:12px;color:#888\">Based on orders, delivery, disputes, and customer ratings<\/div>\n<\/div><\/div>\n<div class=\"card\"><h2>Verification<\/h2><div id=\"verificationStatus\" style=\"font-size:13px;color:#999\">Not verified yet<\/div>\n<div style=\"margin-top:10px\">\n<div class=\"label\">Business Name (as registered)<\/div><input type=\"text\" id=\"verifyBizName\" placeholder=\"e.g. Adebayo Construction Ltd\">\n<div class=\"label\">RC Number (if registered)<\/div><input type=\"text\" id=\"verifyRC\" placeholder=\"RC 1234567\">\n<button class=\"btn btn-sec\" onclick=\"submitVerification()\">Submit for Verification<\/button>\n<\/div><\/div>\n<div class=\"card\"><h2>Disputes<\/h2><div id=\"disputeList\" style=\"font-size:13px;color:#999\">No disputes<\/div><\/div>\n<div class=\"card\"><h2>Audit Log<\/h2><div id=\"auditLog\" style=\"font-size:13px;color:#999\">No actions logged yet<\/div><\/div>\n<\/div>\n\n<\/div>\n<div class=\"nav\">\n<div class=\"nav-item active\" onclick=\"showSection('dash')\"><div class=\"ic\">&#x1F3E0;<\/div>Home<\/div>\n<div class=\"nav-item\" onclick=\"showSection('products')\"><div class=\"ic\">&#x1F4E6;<\/div>Products<\/div>\n<div class=\"nav-item\" onclick=\"showSection('ai')\"><div class=\"ic\">&#x1F916;<\/div>AI<\/div>\n<div class=\"nav-item\" onclick=\"showSection('trust')\"><div class=\"ic\">&#x1F6E1;<\/div>Trust<\/div>\n<\/div>\n<div class=\"toast\" id=\"toast\"><\/div>\n<script>\nfunction toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000)}\nfunction showSection(s){document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));document.getElementById(s+'Section').classList.add('active');document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));event.currentTarget.classList.add('active');if(s==='dash')loadDash();if(s==='products')loadProducts();if(s==='ai')loadAI();if(s==='trust')loadTrust()}\n\n// AI Setup Chat\nlet setupSessionId=null;\nasync function sendSetupMsg(){const inp=document.getElementById('setupInput');const msg=inp.value.trim();if(!msg)return;inp.value='';const chat=document.getElementById('setupChat');chat.innerHTML+='<div class=\"chat-msg user\">'+msg.replace(/<\/g,'&lt;')+'<\/div>';chat.scrollTop=chat.scrollHeight;\nconst r=await fetch('/api/ai-setup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({session_id:setupSessionId,message:msg})});const d=await r.json();\nif(d.response){chat.innerHTML+='<div class=\"chat-msg bot\">'+d.response.replace(/\\n/g,'<br>')+'<\/div>';}chat.scrollTop=chat.scrollHeight;\nif(d.session_id)setupSessionId=d.session_id;\nif(d.launched&&d.merchant_id){toast('Store launched successfully!');localStorage.setItem('merchantId',d.merchant_id);setTimeout(()=>{showSection('dash');loadDash()},2000)}}\n\n// Dashboard\nasync function loadDash(){const mid=localStorage.getItem('merchantId');if(!mid){showSection('landing');return}\nconst r=await fetch('/api/dashboard?merchant_id='+mid);const d=await r.json();\nif(d.success){\ndocument.getElementById('stOrders').textContent=d.stats.orders_today||0;\ndocument.getElementById('stRevenue').textContent='N'+(d.stats.revenue_today||0).toLocaleString();\ndocument.getElementById('stPending').textContent=d.stats.pending||0;\ndocument.getElementById('stIssues').textContent=d.stats.issues||0;\ndocument.getElementById('earnGross').textContent='N'+(d.earnings.gross||0).toLocaleString();\ndocument.getElementById('earnComm').textContent='N'+(d.earnings.commission||0).toLocaleString();\ndocument.getElementById('earnDel').textContent='N'+(d.earnings.delivery||0).toLocaleString();\ndocument.getElementById('earnNet').textContent='N'+(d.earnings.net||0).toLocaleString();\nif(d.orders&&d.orders.length>0){document.getElementById('dashOrders').innerHTML=d.orders.slice(0,10).map(o=>'<div style=\"padding:6px 0;border-bottom:1px solid #eee\"><strong>'+o.product_name+'<\/strong> x'+o.quantity+' - N'+(o.amount||0).toLocaleString()+' <span class=\"tag '+(o.status==='paid'?'green':o.status==='pending'?'amber':'red')+'\">'+o.status+'<\/span><\/div>').join('');}\nif(d.products&&d.products.length>0){document.getElementById('dashInventory').innerHTML=d.products.map(p=>'<div style=\"padding:4px 0;border-bottom:1px solid #eee\">'+p.name+' - '+p.stock+' left @ N'+p.price.toLocaleString()+'<\/div>').join('');}\nif(d.ai_actions&&d.ai_actions.length>0){document.getElementById('dashActions').innerHTML=d.ai_actions.slice(0,10).map(a=>'<div style=\"padding:4px 0;border-bottom:1px solid #eee\"><span style=\"font-size:11px;color:#888\">'+a.created_at.slice(0,16)+'<\/span> '+a.action+'<\/div>').join('');}\n}}\n\n// Products\nasync function loadProducts(){const mid=localStorage.getItem('merchantId');if(!mid)return;\nconst r=await fetch('/api/products?merchant_id='+mid);const d=await r.json();\nif(d.products&&d.products.length>0){document.getElementById('productList').innerHTML=d.products.map(p=>'<div style=\"padding:8px 0;border-bottom:1px solid #eee\"><strong>'+p.name+'<\/strong> - N'+p.price.toLocaleString()+' (stock: '+p.stock+') <button class=\"btn-sm\" style=\"background:#fee2e2;color:#dc2626;float:right\" onclick=\"delProduct(\\''+p.id+'\\')\">Delete<\/button><\/div>').join('');}}\nasync function addProduct(){const mid=localStorage.getItem('merchantId');if(!mid){toast('Setup your store first');return}const n=document.getElementById('prodName').value.trim();const p=parseFloat(document.getElementById('prodPrice').value);const s=parseInt(document.getElementById('prodStock').value)||0;const c=document.getElementById('prodCategory').value.trim();if(!n||!p){toast('Name and price required');return}const r=await fetch('/api/products',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({merchant_id:mid,name:n,price:p,stock:s,category:c})});const d=await r.json();if(d.success){toast('Product added!');document.getElementById('prodName').value='';document.getElementById('prodPrice').value='';document.getElementById('prodStock').value='';loadProducts()}else{toast(d.error||'Failed')}}\nasync function delProduct(pid){const mid=localStorage.getItem('merchantId');const r=await fetch('/api/products/'+pid,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({merchant_id:mid})});const d=await r.json();if(d.success){toast('Deleted');loadProducts()}}\n\n// AI Settings\nasync function loadAI(){const mid=localStorage.getItem('merchantId');if(!mid)return;\nconst pr=await fetch('/api/permissions?merchant_id='+mid);const pd=await pr.json();\nif(pd.permissions){document.getElementById('permissionsList').innerHTML=Object.entries(pd.permissions).map(([k,v])=>'<div style=\"padding:6px 0;border-bottom:1px solid #f0f0f0\"><div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-weight:600;font-size:12px\">'+k.replace(/_/g,' ')+'<\/span><span class=\"tag '+(v.auto?'green':'amber')+'\" style=\"cursor:pointer\" onclick=\"togglePermission(\\''+k+'\\')\">'+(v.auto?'AUTO':'MANUAL')+'<\/span><\/div><div style=\"font-size:11px;color:#888\">'+v.desc+'<\/div><\/div>').join('');}\nconst sr=await fetch('/api/merchants/'+mid);const sd=await sr.json();\nif(sd.merchant){const st=sd.merchant.status;document.getElementById('storeStatus').innerHTML='Status: <span class=\"tag '+(st==='live'?'green':'amber')+'\">'+st+'<\/span>';document.getElementById('storeToggleBtn').textContent=st==='live'?'Pause Store':'Go Live';}}\nasync function togglePermission(perm){const mid=localStorage.getItem('merchantId');const r=await fetch('/api/permissions',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({merchant_id:mid,permission:perm})});const d=await r.json();if(d.success){toast('Updated');loadAI()}}\nasync function toggleStore(){const mid=localStorage.getItem('merchantId');const sr=await fetch('/api/merchants/'+mid);const sd=await sr.json();const newStatus=sd.merchant.status==='live'?'paused':'live';const r=await fetch('/api/merchants/'+mid,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:newStatus})});const d=await r.json();if(d.success){toast('Store '+newStatus);loadAI()}}\n\n// Trust\nasync function loadTrust(){const mid=localStorage.getItem('merchantId');if(!mid)return;\nconst r=await fetch('/api/trust/'+mid);const d=await r.json();\nif(d.success){\ndocument.getElementById('trustScore').textContent=d.trust_score+'/100';\nif(d.verification){document.getElementById('verificationStatus').innerHTML='<span class=\"tag '+d.verification.status==='verified'?'green':'amber'+'\">'+d.verification.status+'<\/span>';}\nif(d.disputes&&d.disputes.length>0){document.getElementById('disputeList').innerHTML=d.disputes.map(dp=>'<div style=\"padding:6px 0;border-bottom:1px solid #eee\">#'+dp.id.slice(0,8)+' - '+dp.reason+' <span class=\"tag '+dp.status+'\">'+dp.status+'<\/span><\/div>').join('');}\nif(d.audit&&d.audit.length>0){document.getElementById('auditLog').innerHTML=d.audit.slice(0,10).map(a=>'<div style=\"padding:4px 0;border-bottom:1px solid #eee\"><span style=\"font-size:11px;color:#888\">'+a.created_at.slice(0,16)+'<\/span> '+a.action+'<\/div>').join('');}\n}}\n\n// Login\nasync function loginMerchant(){const ph=document.getElementById('loginPhone').value.trim();if(!ph){toast('Enter phone number');return}const r=await fetch('/api/merchants/lookup?phone='+normalizePhone(ph));const d=await r.json();if(d.merchant_id){localStorage.setItem('merchantId',d.merchant_id);showSection('dash');loadDash()}else{toast('No merchant found. Set up your store first.')}}\nfunction normalizePhone(p){p=p.replace(/\\s/g,'').replace(/^\\+/,'');if(p.startsWith('0'))return'234'+p.slice(1);if(p.length===10)return'234'+p;return p}\n\n// Init\nconst ref=new URLSearchParams(location.search).get('ref');if(ref){localStorage.setItem('refCode',ref)}if(localStorage.getItem('merchantId')){showSection('dash');loadDash()}else{showSection('landing')}\n<\/script>\n<\/body><\/html>"},{"name":"Harz Mesh Sov","domain":"harz-mesh-sov.hamzarabiu390.workers.dev","url":"https://harz-mesh-sov.hamzarabiu390.workers.dev","status":"live","title":"HARZ Mesh — Sovereignty Test","fetched_at":"2026-10-08T06:49:04Z","size":20880,"html_sha256":"19ad001717828de820ed933a57ebb133b41d0d609c910eb8322076215495007c","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>HARZ Mesh — Sovereignty Test<\/title>\n<link rel=\"manifest\" href=\"/manifest.json\">\n<meta name=\"theme-color\" content=\"#f0f2f5\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<meta name=\"apple-mobile-web-app-title\" content=\"HARZ Mesh\">\n<link rel=\"apple-touch-icon\" href=\"/icon.png\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0f2f5;color:#1a1a2e;padding:12px;max-width:800px;margin:0 auto}\nh1{font-size:20px;text-align:center;margin:15px 0 5px}\nh2{font-size:16px;margin:15px 0 8px;color:#0066cc}\n.sub{text-align:center;color:#666;font-size:13px;margin-bottom:15px}\n.card{background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:15px;margin-bottom:12px}\n.btn{display:block;width:100%;padding:14px;font-size:14px;font-weight:600;border:none;border-radius:8px;margin-bottom:8px;cursor:pointer;text-align:center}\n.btn-primary{background:#0066cc;color:#fff}\n.btn-success{background:#2ed573;color:#000}\n.btn-danger{background:#cc0000;color:#fff}\n.btn-warn{background:#cc6600;color:#fff}\n.btn:disabled{background:#ccc;color:#666;cursor:not-allowed}\n.btn-row{display:flex;gap:8px}\n.btn-row .btn{flex:1}\n.status{font-size:13px;color:#333;margin-bottom:4px}\n.status b{color:#0066cc}\n.code{font-family:monospace;font-size:11px;color:#444;background:#f8f8f8;padding:10px;border-radius:6px;white-space:pre-wrap;word-break:break-all;max-height:400px;overflow-y:auto}\n.test-item{display:flex;justify-content:space-between;align-items:center;padding:10px;border:1px solid #eee;border-radius:8px;margin-bottom:6px}\n.test-item .label{font-size:13px;font-weight:500}\n.test-item .badge{font-size:11px;padding:3px 8px;border-radius:12px;font-weight:600}\n.badge-pass{background:#d4edda;color:#155724}\n.badge-fail{background:#f8d7da;color:#721c24}\n.badge-partial{background:#fff3cd;color:#856404}\n.badge-pending{background:#e2e3e5;color:#383d41}\n.badge-idle{background:#e2e3e5;color:#383d41}\n.warn{font-size:12px;color:#cc6600;background:#fff8e1;padding:10px;border-radius:8px;margin:8px 0}\n.gate-status{display:flex;gap:15px;flex-wrap:wrap;margin:8px 0}\n.gate-stat{font-size:12px;color:#333}\n.gate-stat b{color:#0066cc}\n.evidence{background:#f8f8f8;border:1px solid #ddd;border-radius:8px;padding:12px;margin:8px 0;font-family:monospace;font-size:11px;white-space:pre-wrap;word-break:break-all}\n.verdict{text-align:center;font-size:18px;font-weight:bold;padding:15px;border-radius:8px;margin:10px 0}\n.verdict-green{background:#d4edda;color:#155724}\n.verdict-yellow{background:#fff3cd;color:#856404}\n.verdict-red{background:#f8d7da;color:#721c24}\n.spinner{display:inline-block;width:16px;height:16px;border:2px solid #0066cc;border-top:transparent;border-radius:50%;animation:spin 1s linear infinite;margin-right:5px}\n@keyframes spin{to{transform:rotate(360deg)}}\n.toggle{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #eee}\n.toggle label{font-size:14px;color:#333}\n.switch{position:relative;width:44px;height:24px}\n.switch input{opacity:0;width:0;height:0}\n.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#ccc;border-radius:24px;transition:.3s}\n.slider:before{content:\"\";position:absolute;height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.3s}\ninput:checked+.slider{background:#0066cc}\ninput:checked+.slider:before{transform:translateX(20px)}\ninput[type=text],textarea{width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-size:13px;margin-bottom:8px;font-family:inherit}\ntextarea{min-height:60px}\n<\/style>\n<\/head>\n<body>\n<h1>HARZ Mesh<\/h1>\n<p class=\"sub\">Sovereignty Test v1.0 — Research 10B<\/p>\n\n<div class=\"card\">\n<h2>Island Gateway Status<\/h2>\n<div id=\"gatewayStatus\">\n<p class=\"status\">Checking gateway...<\/p>\n<\/div>\n<\/div>\n\n<div class=\"card\">\n<h2>Test Setup<\/h2>\n<div class=\"toggle\">\n<label>Sovereignty Mode (block internet)<\/label>\n<div class=\"switch\"><input type=\"checkbox\" id=\"sovMode\" checked><span class=\"slider\"><\/span><\/div>\n<\/div>\n<div class=\"toggle\">\n<label>BLE Transport<\/label>\n<div class=\"switch\"><input type=\"checkbox\" id=\"bleEnabled\" checked><span class=\"slider\"><\/span><\/div>\n<\/div>\n<div class=\"toggle\">\n<label>Wi-Fi Direct Transport<\/label>\n<div class=\"switch\"><input type=\"checkbox\" id=\"wifiDirectEnabled\" checked><span class=\"slider\"><\/span><\/div>\n<\/div>\n<div class=\"warn\">\nBefore Test 2+: Enable Airplane Mode on BOTH phones.\nOnly turn Bluetooth ON after Airplane Mode is active.\nDo NOT connect to Wi-Fi, hotspot, or router.\n<\/div>\n<\/div>\n\n<div class=\"card\">\n<h2>Sovereignty Test Protocol<\/h2>\n<div class=\"test-item\" id=\"test0\">\n<span class=\"label\">Test 0: Baseline Check<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div class=\"test-item\" id=\"test1\">\n<span class=\"label\">Test 1: Internet Isolation<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div class=\"test-item\" id=\"test2\">\n<span class=\"label\">Test 2: BLE-only (SOV-001)<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div class=\"test-item\" id=\"test3\">\n<span class=\"label\">Test 3: Wi-Fi Direct (SOV-002)<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div class=\"test-item\" id=\"test4\">\n<span class=\"label\">Test 4: Transport Independence (SOV-003)<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div class=\"test-item\" id=\"test5\">\n<span class=\"label\">Test 5: Store-and-Forward (SOV-004)<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div class=\"test-item\" id=\"test6\">\n<span class=\"label\">Test 6: Reboot Persistence (SOV-005)<\/span>\n<span class=\"badge badge-idle\">IDLE<\/span>\n<\/div>\n<div style=\"margin-top:10px\">\n<button class=\"btn btn-primary\" onclick=\"runTest(0)\">Run Test 0: Baseline<\/button>\n<button class=\"btn btn-warn\" onclick=\"runTest(1)\">Run Test 1: Confirm Isolation<\/button>\n<button class=\"btn btn-primary\" onclick=\"runTest(2)\" id=\"btn2\">Run Test 2: BLE Delivery<\/button>\n<button class=\"btn btn-primary\" onclick=\"runTest(3)\" id=\"btn3\">Run Test 3: Wi-Fi Direct<\/button>\n<button class=\"btn btn-primary\" onclick=\"runTest(4)\" id=\"btn4\">Run Test 4: Reroute<\/button>\n<button class=\"btn btn-primary\" onclick=\"runTest(5)\" id=\"btn5\">Run Test 5: Store-Forward<\/button>\n<button class=\"btn btn-primary\" onclick=\"runTest(6)\" id=\"btn6\">Run Test 6: Reboot<\/button>\n<\/div>\n<\/div>\n\n<div class=\"card\" id=\"telemetryCard\" style=\"display:none\">\n<h2>Current Test Telemetry<\/h2>\n<div id=\"telemetry\" class=\"code\"><\/div>\n<\/div>\n\n<div class=\"card\" id=\"evidenceCard\" style=\"display:none\">\n<h2>Evidence Chain<\/h2>\n<div id=\"evidence\" class=\"evidence\"><\/div>\n<button class=\"btn btn-success\" onclick=\"exportEvidence()\">Export All Evidence<\/button>\n<\/div>\n\n<div class=\"card\" id=\"verdictCard\" style=\"display:none\">\n<h2>Overall Verdict<\/h2>\n<div id=\"verdict\" class=\"verdict\"><\/div>\n<\/div>\n\n<div class=\"card\">\n<h2>Gateway Bundle Submission (Test)<\/h2>\n<p class=\"status\">Submit a test bundle to verify Island Gateway CRDT sync:<\/p>\n<input type=\"text\" id=\"bundleMsg\" placeholder=\"Message content (e.g. HARZ-MESH-SOV-001)\" value=\"HARZ-MESH-SOV-001\">\n<button class=\"btn btn-primary\" onclick=\"submitBundle()\">Submit Test Bundle<\/button>\n<div id=\"bundleResult\" class=\"code\" style=\"margin-top:8px\"><\/div>\n<\/div>\n\n<div class=\"card\">\n<h2>Gateway CRDT State<\/h2>\n<button class=\"btn btn-primary\" onclick=\"loadCRDT()\">Load Current CRDT State<\/button>\n<div id=\"crdtState\" class=\"code\" style=\"margin-top:8px\"><\/div>\n<\/div>\n\n<script>\nconst GATEWAY = 'https://island.hamzarabiu390.workers.dev';\nconst results = {};\nlet airplaneConfirmed = false;\n\n// === GATEWAY STATUS ===\nasync function checkGateway() {\n  try {\n    const r = await fetch(GATEWAY + '/api/health');\n    const d = await r.json();\n    document.getElementById('gatewayStatus').innerHTML = \n      '<div class=\"gate-status\">' +\n      '<span class=\"gate-stat\">Status: <b>' + d.status + '<\/b><\/span>' +\n      '<span class=\"gate-stat\">Bundles: <b>' + d.bundlesReceived + '<\/b><\/span>' +\n      '<span class=\"gate-stat\">Nodes: <b>' + d.nodeCount + '<\/b><\/span>' +\n      '<span class=\"gate-stat\">CRDT Keys: <b>' + d.crdtKeys + '<\/b><\/span>' +\n      '<\/div>' +\n      '<span class=\"gate-stat\">Service: ' + d.service + '<\/span>';\n  } catch(e) {\n    document.getElementById('gatewayStatus').innerHTML = '<p class=\"status\" style=\"color:#cc0000\">Gateway unreachable: ' + e.message + '<\/p>';\n  }\n}\n\n// === TEST RUNNER ===\nfunction setTestStatus(testNum, status, detail) {\n  const el = document.getElementById('test' + testNum);\n  if (!el) return;\n  const badge = el.querySelector('.badge');\n  badge.className = 'badge badge-' + status.toLowerCase();\n  badge.textContent = status;\n  if (detail) {\n    badge.textContent += ' — ' + detail;\n  }\n}\n\nfunction createTelemetry(testId, messageContent) {\n  return {\n    testId: testId,\n    messageContent: messageContent,\n    startTime: Date.now(),\n    discoveryTime: null,\n    handshakeTime: null,\n    transportSelected: null,\n    messageCreatedTime: null,\n    messageReceivedTime: null,\n    deliveryAckTime: null,\n    messageId: null,\n    senderIdentity: 'web-dashboard',\n    receiverIdentity: null,\n    cryptoVerified: false,\n    duplicateCount: 0,\n    internetAvailable: navigator.onLine,\n    cellularAvailable: false,\n    wifiConnected: navigator.onLine,\n    transportUsed: null,\n    deliveryStatus: 'PENDING',\n    failureReason: null,\n  };\n}\n\nfunction buildEvidenceChain(t) {\n  return [\n    '=== HARZ MESH SOVEREIGNTY TEST EVIDENCE ===',\n    'Test ID: ' + t.testId,\n    'Message: ' + t.messageContent,\n    'Timestamp: ' + new Date(t.startTime).toISOString(),\n    '',\n    '--- Connectivity Status ---',\n    'Internet: ' + (t.internetAvailable ? 'AVAILABLE' : 'UNAVAILABLE'),\n    'Cellular: ' + (t.cellularAvailable ? 'AVAILABLE' : 'UNAVAILABLE'),\n    'Wi-Fi Router: ' + (t.wifiConnected ? 'CONNECTED' : 'NOT CONNECTED'),\n    '',\n    '--- Transport Chain ---',\n    'Device A -> DORS -> ' + (t.transportUsed || 'NONE') + ' -> DORS -> Device B',\n    'Transport Selected: ' + (t.transportSelected || 'N/A'),\n    '',\n    '--- Timing ---',\n    'Discovery: ' + (t.discoveryTime ? (t.discoveryTime - t.startTime) + 'ms' : 'N/A'),\n    'Handshake: ' + (t.handshakeTime ? (t.handshakeTime - t.startTime) + 'ms' : 'N/A'),\n    'Message Created: ' + (t.messageCreatedTime ? new Date(t.messageCreatedTime).toISOString() : 'N/A'),\n    'Message Received: ' + (t.messageReceivedTime ? new Date(t.messageReceivedTime).toISOString() : 'N/A'),\n    'Delivery ACK: ' + (t.deliveryAckTime ? new Date(t.deliveryAckTime).toISOString() : 'N/A'),\n    '',\n    '--- Identity ---',\n    'Sender Identity: ' + (t.senderIdentity || 'N/A'),\n    'Receiver Identity: ' + (t.receiverIdentity || 'N/A'),\n    'Crypto Verified: ' + (t.cryptoVerified ? 'YES' : 'NO'),\n    '',\n    '--- Delivery ---',\n    'Message ID: ' + (t.messageId || 'N/A'),\n    'Duplicate Count: ' + t.duplicateCount,\n    'Delivery Status: ' + t.deliveryStatus,\n    'Failure Reason: ' + (t.failureReason || 'N/A'),\n    '',\n    '=== END EVIDENCE ===',\n  ].join('\\n');\n}\n\nfunction showTelemetry(t) {\n  document.getElementById('telemetryCard').style.display = 'block';\n  document.getElementById('telemetry').textContent = JSON.stringify(t, null, 2);\n  \n  if (t.deliveryStatus !== 'PENDING') {\n    document.getElementById('evidenceCard').style.display = 'block';\n    document.getElementById('evidence').textContent = buildEvidenceChain(t);\n  }\n}\n\nasync function runTest(num) {\n  const messages = ['BASELINE', 'ISOLATION-CHECK', 'HARZ-MESH-SOV-001', 'HARZ-MESH-SOV-002', 'HARZ-MESH-SOV-003', 'HARZ-MESH-SOV-004', 'HARZ-MESH-SOV-005'];\n  const testNames = ['TEST-0','TEST-1','TEST-2','TEST-3','TEST-4','TEST-5','TEST-6'];\n  \n  const t = createTelemetry(testNames[num], messages[num]);\n  setTestStatus(num, 'PENDING', 'running...');\n  \n  if (num === 0) {\n    // Baseline: check gateway connectivity\n    setTestStatus(0, 'PENDING', 'checking gateway...');\n    try {\n      const r = await fetch(GATEWAY + '/api/health');\n      const d = await r.json();\n      t.messageCreatedTime = Date.now();\n      t.transportUsed = 'INTERNET (baseline only)';\n      t.deliveryStatus = 'SUCCESS';\n      t.messageId = 'baseline-' + Date.now();\n      results[0] = t;\n      setTestStatus(0, 'PASS', 'gateway online');\n      showTelemetry(t);\n    } catch(e) {\n      t.deliveryStatus = 'FAIL';\n      t.failureReason = e.message;\n      results[0] = t;\n      setTestStatus(0, 'FAIL', e.message);\n      showTelemetry(t);\n    }\n  } else if (num === 1) {\n    // Isolation check\n    setTestStatus(1, 'PENDING', 'verifying isolation...');\n    const hasInternet = navigator.onLine;\n    t.internetAvailable = hasInternet;\n    \n    if (hasInternet) {\n      t.deliveryStatus = 'FAIL';\n      t.failureReason = 'Internet still available — enable Airplane Mode first';\n      results[1] = t;\n      setTestStatus(1, 'FAIL', 'internet still on');\n      showTelemetry(t);\n      alert('Enable Airplane Mode on both phones first! Internet is still available.');\n    } else {\n      t.deliveryStatus = 'SUCCESS';\n      airplaneConfirmed = true;\n      results[1] = t;\n      setTestStatus(1, 'PASS', 'internet confirmed off');\n      showTelemetry(t);\n      // Enable test buttons\n      for (let i = 2; i <= 6; i++) {\n        document.getElementById('btn' + i).disabled = false;\n      }\n    }\n  } else if (num >= 2 && num <= 6) {\n    // These tests require the physical mesh client on phones\n    // The PWA dashboard records the test as initiated and waits for gateway confirmation\n    setTestStatus(num, 'PENDING', 'awaiting phone delivery...');\n    \n    // Submit the test message to the gateway as a CRDT entry\n    try {\n      const ts = Date.now();\n      const bundle = {\n        id: 'harz-mesh-sov-' + num + '-' + ts,\n        primary: {\n          nodeId: 'web-dashboard',\n          source: 'web-dashboard',\n          destination: 'dtn://gateway/crdt-sync',\n          seq: num,\n          creationTime: ts,\n        },\n        payload: {\n          type: 'sovereignty-test',\n          content: messages[num],\n          testNumber: num,\n          testName: testNames[num],\n          internetAvailable: navigator.onLine,\n          sovereigntyMode: document.getElementById('sovMode').checked,\n          bleEnabled: document.getElementById('bleEnabled').checked,\n          wifiDirectEnabled: document.getElementById('wifiDirectEnabled').checked,\n          updates: [{\n            key: 'sov:test' + num,\n            value: messages[num],\n            nodeId: 'web-dashboard',\n            source: 'web-dashboard',\n            seq: num,\n            timestamp: ts,\n          }],\n        },\n        originalSource: 'web-dashboard',\n        timestamp: ts,\n        signature: 'pwa-dashboard-no-crypto',\n      };\n      \n      const r = await fetch(GATEWAY + '/api/bundle', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify(bundle),\n      });\n      const d = await r.json();\n      \n      t.messageCreatedTime = Date.now();\n      t.messageId = bundle.id;\n      t.transportUsed = 'PENDING-PHONE-DELIVERY';\n      t.cryptoVerified = false;\n      t.deliveryStatus = 'PENDING';\n      t.failureReason = 'Test message registered in gateway. Phone mesh client must deliver via BLE/Wi-Fi Direct. Check gateway CRDT for delivery confirmation.';\n      results[num] = t;\n      setTestStatus(num, 'PENDING', 'awaiting phone');\n      showTelemetry(t);\n      \n      // Auto-check gateway for delivery\n      setTimeout(() => checkDelivery(num, bundle.id, t), 30000);\n      setTimeout(() => checkDelivery(num, bundle.id, t), 60000);\n      setTimeout(() => checkDelivery(num, bundle.id, t), 120000);\n    } catch(e) {\n      t.deliveryStatus = 'FAIL';\n      t.failureReason = e.message;\n      results[num] = t;\n      setTestStatus(num, 'FAIL', e.message);\n      showTelemetry(t);\n    }\n  }\n}\n\nasync function checkDelivery(testNum, bundleId, t) {\n  try {\n    const r = await fetch(GATEWAY + '/api/crdt');\n    const d = await r.json();\n    const crdt = d.crdt || {};\n    const key = 'sov:test' + testNum;\n    \n    if (crdt[key] && crdt[key].source !== 'web-dashboard') {\n      // Delivered by a phone node!\n      t.messageReceivedTime = Date.now();\n      t.deliveryAckTime = Date.now();\n      t.transportUsed = crdt[key].source || 'PHONE-MESH';\n      t.receiverIdentity = crdt[key].source;\n      t.cryptoVerified = true;\n      t.deliveryStatus = 'SUCCESS';\n      results[testNum] = t;\n      setTestStatus(testNum, 'PASS', 'delivered by ' + crdt[key].source);\n      showTelemetry(t);\n      updateVerdict();\n    } else if (crdt[key] && crdt[key].hops > 0) {\n      t.messageReceivedTime = Date.now();\n      t.transportUsed = 'MESH-RELAY';\n      t.deliveryStatus = 'SUCCESS';\n      t.cryptoVerified = true;\n      results[testNum] = t;\n      setTestStatus(testNum, 'PASS', 'relay delivered');\n      showTelemetry(t);\n      updateVerdict();\n    }\n  } catch(e) {\n    // Gateway check failed, will retry\n  }\n}\n\nfunction updateVerdict() {\n  const testNums = [2, 3, 4, 5, 6]; // Core tests\n  const completed = testNums.filter(n => results[n] && results[n].deliveryStatus !== 'PENDING');\n  if (completed.length < 5) return; // Need all 5 core tests\n  \n  const allPass = testNums.every(n => results[n] && results[n].deliveryStatus === 'SUCCESS');\n  const somePass = testNums.some(n => results[n] && results[n].deliveryStatus === 'SUCCESS');\n  \n  const v = document.getElementById('verdict');\n  const card = document.getElementById('verdictCard');\n  card.style.display = 'block';\n  \n  if (allPass) {\n    v.className = 'verdict verdict-green';\n    v.textContent = '🟢 MESH SOVEREIGNTY PASS';\n  } else if (somePass) {\n    v.className = 'verdict verdict-yellow';\n    v.textContent = '🟡 PARTIAL';\n  } else {\n    v.className = 'verdict verdict-red';\n    v.textContent = '🔴 FAIL';\n  }\n}\n\n// === BUNDLE SUBMISSION ===\nasync function submitBundle() {\n  const msg = document.getElementById('bundleMsg').value || 'HARZ-MESH-SOV-001';\n  const el = document.getElementById('bundleResult');\n  el.textContent = 'Submitting...';\n  \n  try {\n    const ts = Date.now();\n    const bundle = {\n      id: 'harz-mesh-sov-manual-' + ts,\n      primary: {\n        nodeId: 'web-dashboard',\n        source: 'web-dashboard',\n        destination: 'dtn://gateway/crdt-sync',\n        seq: 1,\n        creationTime: ts,\n      },\n      payload: {\n        type: 'text',\n        content: msg,\n        updates: [{\n          key: 'msg:' + ts,\n          value: msg,\n          nodeId: 'web-dashboard',\n          source: 'web-dashboard',\n          seq: 1,\n          timestamp: ts,\n        }],\n      },\n      originalSource: 'web-dashboard',\n      timestamp: ts,\n      signature: 'pwa-manual-test',\n    };\n    \n    const r = await fetch(GATEWAY + '/api/bundle', {\n      method: 'POST',\n      headers: {'Content-Type': 'application/json'},\n      body: JSON.stringify(bundle),\n    });\n    const d = await r.json();\n    el.textContent = JSON.stringify(d, null, 2);\n    checkGateway();\n  } catch(e) {\n    el.textContent = 'Error: ' + e.message;\n  }\n}\n\n// === CRDT LOADER ===\nasync function loadCRDT() {\n  const el = document.getElementById('crdtState');\n  el.textContent = 'Loading...';\n  try {\n    const r = await fetch(GATEWAY + '/api/crdt');\n    const d = await r.json();\n    el.textContent = JSON.stringify(d, null, 2);\n  } catch(e) {\n    el.textContent = 'Error: ' + e.message;\n  }\n}\n\n// === EXPORT ===\nfunction exportEvidence() {\n  const allResults = Object.values(results);\n  if (allResults.length === 0) {\n    alert('No test results to export');\n    return;\n  }\n  \n  const report = allResults.map(t => buildEvidenceChain(t)).join('\\n\\n');\n  const summary = [\n    '=== HARZ MESH SOVEREIGNTY TEST SUMMARY ===',\n    'Date: ' + new Date().toISOString(),\n    'Tests Run: ' + allResults.length,\n    '',\n    ...allResults.map(t => t.testId + ': ' + t.deliveryStatus + (t.failureReason ? ' — ' + t.failureReason : '')),\n    '',\n    '=== EVIDENCE CHAINS ===',\n    '',\n    ...allResults.map(t => buildEvidenceChain(t)),\n  ].join('\\n');\n  \n  // Download as file\n  const blob = new Blob([summary], {type: 'text/plain'});\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.href = url;\n  a.download = 'harz-mesh-sov-evidence-' + Date.now() + '.txt';\n  a.click();\n  URL.revokeObjectURL(url);\n}\n\n// === INIT ===\ncheckGateway();\nsetInterval(checkGateway, 30000);\n\n// Disable test buttons until isolation confirmed\nfor (let i = 2; i <= 6; i++) {\n  document.getElementById('btn' + i).disabled = true;\n}\n\n// Service worker registration\nif ('serviceWorker' in navigator) {\n  navigator.serviceWorker.register('/sw.js').catch(() => {});\n}\n<\/script>\n<\/body>\n<\/html>"},{"name":"Harz Music","domain":"harz-music.vercel.app","url":"https://harz-music.vercel.app","status":"dead","title":"","fetched_at":"2026-10-08T06:49:04Z","size":107,"html_sha256":""},{"name":"Harz Network B","domain":"harz-network-b.hamzarabiu390.workers.dev","url":"https://harz-network-b.hamzarabiu390.workers.dev","status":"live","title":"HARZ Network B","fetched_at":"2026-10-08T06:49:04Z","size":1855,"html_sha256":"d97bf5e6143f29ec44577fec1336a88f587f5f3e8474c139a11ae3b807960a29","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"theme-color\" content=\"#1a73e8\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><link rel=\"manifest\" href=\"/manifest.json\"><link rel=\"icon\" href=\"/icon.svg\"><title>HARZ Network B<\/title><style>body{font-family:system-ui;background:#f0f2f5;margin:0;padding:24px;color:#111}.card{background:#fff;border-radius:12px;padding:16px;margin-bottom:16px;box-shadow:0 1px 3px rgba(0,0,0,.08)}.sub{color:#555;font-size:13px}pre{white-space:pre-wrap;font-size:12px;background:#fafafa;padding:8px;border-radius:8px;overflow:auto}<\/style><\/head><body><h2>HARZ Network B <span class=\"sub\">v0.1.0-sovereign-corridor<\/span><\/h2><div class=\"sub\">Sovereign network — own council, own ledger. Corridor value moves on independently recomputed proof, never on trust.<\/div><div class=\"card\"><h3>State<\/h3><pre id=\"st\">loading…<\/pre><\/div><div class=\"card\"><h3>Tombstones (public refusals)<\/h3><pre id=\"ts\">loa