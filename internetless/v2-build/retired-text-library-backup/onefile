/harz-neural.hamzarabiu390.workers.dev","status":"live","title":"HARZ NEURAL — Self-Aware Infrastructure Brain","fetched_at":"2026-10-08T06:49:04Z","size":14051,"html_sha256":"799dd51812159f2d0d8276516addb2b411c1cc589d8dafcd2ade28037e3c707d","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><link rel=\"manifest\" href=\"/manifest.json\">\n<meta charset=\"UTF-8\">\n<meta name=\"theme-color\" content=\"#f0f2f5\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\"><meta name=\"apple-mobile-web-app-title\" content=\"HARZ NEURAL\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>HARZ NEURAL — Self-Aware Infrastructure Brain<\/title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#f0f2f5;color:#1a1a2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',monospace;overflow:hidden;height:100vh}\n#canvas{position:fixed;top:0;left:0;width:100%;height:100%}\n.header{position:fixed;top:0;left:0;right:0;z-index:10;background:linear-gradient(180deg,rgba(240,242,245,0.95),rgba(240,242,245,0.7),transparent);padding:20px 30px}\n.header h1{font-size:1.8em;background:linear-gradient(90deg,#e94560,#0f3460,#16c79a,#e94560);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-size:200% auto;animation:shimmer 3s linear infinite;margin-bottom:4px}\n@keyframes shimmer{to{background-position:200% center}}\n.header .subtitle{color:#666;font-size:0.85em;letter-spacing:2px}\n.stats{position:fixed;top:80px;left:30px;z-index:10;display:flex;gap:15px;flex-wrap:wrap}\n.stat{background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;padding:8px 16px;text-align:center;backdrop-filter:blur(10px)}\n.stat .num{font-size:1.5em;font-weight:700;color:#e94560}\n.stat .label{font-size:0.7em;color:#666;letter-spacing:1px}\n.panel{position:fixed;bottom:0;left:0;right:0;z-index:10;background:linear-gradient(0deg,rgba(240,242,245,0.95),rgba(240,242,245,0.7),transparent);padding:20px 30px}\n.panel-content{max-width:800px;margin:0 auto;text-align:center}\n.thinker{display:flex;gap:10px;justify-content:center;align-items:center}\n.thinker input{background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;padding:10px 16px;color:#1a1a2e;font-size:1em;width:400px;outline:none}\n.thinker input:focus{border-color:#e94560;box-shadow:0 0 15px rgba(233,69,96,0.2)}\n.thinker button{background:linear-gradient(90deg,#e94560,#0f3460);border:none;border-radius:8px;padding:10px 20px;color:#fff;font-weight:700;cursor:pointer;font-size:0.9em}\n.thinker button:hover{transform:scale(1.05);box-shadow:0 0 20px rgba(233,69,96,0.3)}\n#thought-result{margin-top:10px;font-size:0.85em;color:#888;min-height:20px}\n#thought-result .route{color:#16c79a}\n#thought-result .error{color:#e94560}\n.legend{position:fixed;top:80px;right:30px;z-index:10;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;padding:12px;backdrop-filter:blur(10px)}\n.legend h3{font-size:0.75em;color:#666;margin-bottom:8px;letter-spacing:1px}\n.legend-item{display:flex;align-items:center;gap:8px;margin:4px 0;font-size:0.8em}\n.legend-dot{width:10px;height:10px;border-radius:50%}\n.actions{position:fixed;bottom:80px;right:30px;z-index:10;display:flex;flex-direction:column;gap:8px}\n.action-btn{background:#ffffff;border:1px solid #e5e7eb;border-radius:6px;padding:6px 14px;color:#1a1a2e;cursor:pointer;font-size:0.8em;backdrop-filter:blur(10px)}\n.action-btn:hover{border-color:#e94560;background:rgba(233,69,96,0.1)}\n.loader{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:20;text-align:center}\n.loader .spinner{width:60px;height:60px;border:3px solid rgba(233,69,96,0.1);border-top:3px solid #e94560;border-radius:50%;animation:spin 1s linear infinite;margin:0 auto 15px}\n@keyframes spin{100%{transform:rotate(360deg)}}\n.loader p{color:#666;font-size:0.85em}\n<\/style>\n<\/head>\n<body>\n<canvas id=\"canvas\"><\/canvas>\n\n<div class=\"header\">\n<h1>HARZ NEURAL<\/h1>\n<div class=\"subtitle\">THE WORLDS FIRST SELF-AWARE INFRASTRUCTURE BRAIN<\/div>\n<\/div>\n\n<div class=\"stats\" id=\"stats\">\n<div class=\"stat\"><div class=\"num\" id=\"stat-neurons\">—<\/div><div class=\"label\">NEURONS<\/div><\/div>\n<div class=\"stat\"><div class=\"num\" id=\"stat-synapses\">—<\/div><div class=\"label\">SYNAPSES<\/div><\/div>\n<div class=\"stat\"><div class=\"num\" id=\"stat-regions\">—<\/div><div class=\"label\">REGIONS<\/div><\/div>\n<div class=\"stat\"><div class=\"num\" id=\"stat-active\">—<\/div><div class=\"label\">ACTIVE<\/div><\/div>\n<\/div>\n\n<div class=\"legend\" id=\"legend\">\n<h3>BRAIN REGIONS<\/h3>\n<div id=\"legend-items\"><\/div>\n<\/div>\n\n<div class=\"actions\">\n<button class=\"action-btn\" onclick=\"scan()\">SCAN NEURONS<\/button>\n<button class=\"action-btn\" onclick=\"pulse()\">HEALTH PULSE<\/button>\n<\/div>\n\n<div class=\"panel\">\n<div class=\"panel-content\">\n<div class=\"thinker\">\n<input type=\"text\" id=\"thought\" placeholder=\"Ask the brain anything... e.g. 'process a payment' or 'check student records'\">\n<button onclick=\"think()\">THINK<\/button>\n<\/div>\n<div id=\"thought-result\"><\/div>\n<\/div>\n<\/div>\n\n<div class=\"loader\" id=\"loader\">\n<div class=\"spinner\"><\/div>\n<p>Awakening consciousness...<\/p>\n<\/div>\n\n<script>\nlet brain = null;\nlet neurons = [];\nlet synapses = [];\nlet positions = {};\nlet animationId = null;\n\n// Initialize\nasync function init() {\n  try {\n    const res = await fetch('/api/brain');\n    const data = await res.json();\n    if (data.success && data.brain) {\n      brain = data.brain;\n      neurons = brain.neurons || [];\n      synapses = brain.synapses || [];\n      updateStats();\n      renderLegend();\n      layoutNeurons();\n      draw();\n      document.getElementById('loader').style.display = 'none';\n      // Auto-pulse\n      pulse();\n    } else {\n      // Need to scan first\n      await scan();\n    }\n  } catch(e) {\n    document.getElementById('loader').querySelector('p').textContent = 'Error: ' + e.message;\n  }\n}\n\nasync function scan() {\n  document.getElementById('loader').style.display = 'block';\n  document.querySelector('.loader p').textContent = 'Scanning all neurons across the infrastructure...';\n  try {\n    const res = await fetch('/api/scan', { method: 'POST' });\n    const data = await res.json();\n    if (data.success) {\n      // Now get the full map\n      const brainRes = await fetch('/api/brain');\n      const brainData = await brainRes.json();\n      if (brainData.success) {\n        brain = brainData.brain;\n        neurons = brain.neurons || [];\n        synapses = brain.synapses || [];\n        updateStats();\n        renderLegend();\n        layoutNeurons();\n        if (!animationId) draw();\n        document.getElementById('loader').style.display = 'none';\n        pulse();\n      }\n    }\n  } catch(e) {\n    document.querySelector('.loader p').textContent = 'Scan failed: ' + e.message;\n  }\n}\n\nasync function pulse() {\n  try {\n    const res = await fetch('/api/pulse', { method: 'POST' });\n    const data = await res.json();\n    if (data.success) {\n      document.getElementById('stat-active').textContent = data.pulse.active || 0;\n      document.getElementById('stat-active').style.color = data.vitality === '100%' ? '#16c79a' : '#e94560';\n      // Update neuron colors\n      if (brain) {\n        const brainRes = await fetch('/api/brain');\n        const brainData = await brainRes.json();\n        if (brainData.success) {\n          brain = brainData.brain;\n          neurons = brain.neurons || [];\n        }\n      }\n    }\n  } catch(e) {}\n}\n\nasync function think() {\n  const query = document.getElementById('thought').value;\n  if (!query) return;\n  document.getElementById('thought-result').innerHTML = '<span style=\"color:#666\">Thinking...<\/span>';\n  try {\n    const res = await fetch('/api/think', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ query }),\n    });\n    const data = await res.json();\n    if (data.success) {\n      const r = data.routed_to;\n      document.getElementById('thought-result').innerHTML = \n        '<span class=\"route\">Routed to: ' + r.neuron + ' [' + r.region + '] → ' + r.url + '<\/span>';\n      // Highlight the neuron\n      highlightNeuron(r.neuron);\n    } else {\n      document.getElementById('thought-result').innerHTML = '<span class=\"error\">' + (data.message || data.error || 'No route found') + '<\/span>';\n    }\n  } catch(e) {\n    document.getElementById('thought-result').innerHTML = '<span class=\"error\">Error: ' + e.message + '<\/span>';\n  }\n}\n\nfunction updateStats() {\n  document.getElementById('stat-neurons').textContent = neurons.length;\n  document.getElementById('stat-synapses').textContent = synapses.length;\n  const regions = new Set(neurons.map(n => n.region));\n  document.getElementById('stat-regions').textContent = regions.size;\n}\n\nfunction renderLegend() {\n  const items = document.getElementById('legend-items');\n  const regions = {};\n  neurons.forEach(n => {\n    if (!regions[n.region]) regions[n.region] = { label: n.regionLabel, color: n.regionColor, count: 0 };\n    regions[n.region].count++;\n  });\n  items.innerHTML = Object.values(regions).map(r => \n    '<div class=\"legend-item\"><div class=\"legend-dot\" style=\"background:' + r.color + '\"><\/div>' + r.label + ' (' + r.count + ')<\/div>'\n  ).join('');\n}\n\nfunction layoutNeurons() {\n  const cx = window.innerWidth / 2;\n  const cy = window.innerHeight / 2;\n  const radius = Math.min(window.innerWidth, window.innerHeight) * 0.35;\n  \n  // Group by region\n  const regionGroups = {};\n  neurons.forEach(n => {\n    if (!regionGroups[n.region]) regionGroups[n.region] = [];\n    regionGroups[n.region].push(n);\n  });\n  \n  const regionKeys = Object.keys(regionGroups);\n  const regionCount = regionKeys.length;\n  \n  Object.entries(regionGroups).forEach(([region, groupNeurons], ri) => {\n    const angle = (ri / regionCount) * Math.PI * 2 - Math.PI / 2;\n    const regionCx = cx + Math.cos(angle) * radius * 0.6;\n    const regionCy = cy + Math.sin(angle) * radius * 0.6;\n    \n    groupNeurons.forEach((n, ni) => {\n      const nAngle = (ni / groupNeurons.length) * Math.PI * 2;\n      const nRadius = Math.min(80, 20 + groupNeurons.length * 5);\n      positions[n.id] = {\n        x: regionCx + Math.cos(nAngle) * nRadius,\n        y: regionCy + Math.sin(nAngle) * nRadius,\n        vx: 0,\n        vy: 0,\n        baseX: regionCx + Math.cos(nAngle) * nRadius,\n        baseY: regionCy + Math.sin(nAngle) * nRadius,\n      };\n    });\n  });\n}\n\nlet highlightId = null;\nlet pulseTime = 0;\n\nfunction highlightNeuron(id) {\n  highlightId = id;\n  setTimeout(() => { highlightId = null; }, 3000);\n}\n\nfunction draw() {\n  const canvas = document.getElementById('canvas');\n  const ctx = canvas.getContext('2d');\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight;\n  \n  pulseTime += 0.02;\n  \n  // Clear with subtle fade\n  ctx.fillStyle = 'rgba(5, 5, 16, 0.15)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  \n  // Draw synapses (connections)\n  synapses.forEach(s => {\n    const from = positions[s.from];\n    const to = positions[s.to];\n    if (!from || !to) return;\n    \n    const alpha = s.strength * 0.3;\n    const isHighlight = highlightId === s.from || highlightId === s.to;\n    \n    if (isHighlight) {\n      ctx.strokeStyle = 'rgba(233, 69, 96, ' + (alpha + 0.5) + ')';\n      ctx.lineWidth = 2;\n    } else {\n      ctx.strokeStyle = 'rgba(100, 100, 150, ' + alpha + ')';\n      ctx.lineWidth = s.strength;\n    }\n    \n    ctx.beginPath();\n    ctx.moveTo(from.x, from.y);\n    ctx.lineTo(to.x, to.y);\n    ctx.stroke();\n    \n    // Signal pulse along strong connections\n    if (s.strength > 0.4 || isHighlight) {\n      const t = (pulseTime + s.from.length * 0.1) % 1;\n      const px = from.x + (to.x - from.x) * t;\n      const py = from.y + (to.y - from.y) * t;\n      ctx.fillStyle = isHighlight ? 'rgba(233, 69, 96, 0.8)' : 'rgba(100, 200, 255, ' + (s.strength * 0.4) + ')';\n      ctx.beginPath();\n      ctx.arc(px, py, 1.5, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  });\n  \n  // Draw neurons\n  neurons.forEach(n => {\n    const pos = positions[n.id];\n    if (!pos) return;\n    \n    const color = n.regionColor || '#666';\n    const isHighlight = highlightId === n.id;\n    const isActive = n.health === 'active';\n    const isOffline = n.health === 'offline';\n    \n    // Glow\n    const glowRadius = isHighlight ? 20 + Math.sin(pulseTime * 5) * 5 : isActive ? 12 : 6;\n    const gradient = ctx.createRadialGradient(pos.x, pos.y, 0, pos.x, pos.y, glowRadius);\n    gradient.addColorStop(0, color + (isHighlight ? 'ff' : isActive ? '80' : '40'));\n    gradient.addColorStop(1, color + '00');\n    ctx.fillStyle = gradient;\n    ctx.beginPath();\n    ctx.arc(pos.x, pos.y, glowRadius, 0, Math.PI * 2);\n    ctx.fill();\n    \n    // Core\n    const coreRadius = isHighlight ? 8 : isActive ? 5 : isOffline ? 3 : 4;\n    ctx.fillStyle = isOffline ? '#333' : color;\n    ctx.beginPath();\n    ctx.arc(pos.x, pos.y, coreRadius, 0, Math.PI * 2);\n    ctx.fill();\n    \n    // Ring for active\n    if (isActive) {\n      ctx.strokeStyle = color + '60';\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      ctx.arc(pos.x, pos.y, coreRadius + 3 + Math.sin(pulseTime * 2 + n.id.length) * 2, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    \n    // Label on hover or highlight\n    if (isHighlight) {\n      ctx.fillStyle = '#fff';\n      ctx.font = '11px monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText(n.name, pos.x, pos.y - 15);\n    }\n  });\n  \n  animationId = requestAnimationFrame(draw);\n}\n\n// Mouse interaction\ndocument.getElementById('canvas').addEventListener('mousemove', (e) => {\n  const rect = e.target.getBoundingClientRect();\n  const mx = e.clientX - rect.left;\n  const my = e.clientY - rect.top;\n  \n  let closest = null;\n  let closestDist = 20;\n  \n  neurons.forEach(n => {\n    const pos = positions[n.id];\n    if (!pos) return;\n    const dist = Math.sqrt((pos.x - mx) ** 2 + (pos.y - my) ** 2);\n    if (dist < closestDist) {\n      closestDist = dist;\n      closest = n.id;\n    }\n  });\n  \n  highlightId = closest;\n});\n\ndocument.getElementById('thought').addEventListener('keypress', (e) => {\n  if (e.key === 'Enter') think();\n});\n\nwindow.addEventListener('resize', () => {\n  if (neurons.length > 0) {\n    layoutNeurons();\n  }\n});\n\n// Start\ninit();\n<\/script>\n<script>if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(()=>{})}<\/script><\/body>\n<\/html>"},{"name":"Harz Omninet","domain":"harz-omninet.hamzarabiu390.workers.dev","url":"https://harz-omninet.hamzarabiu390.workers.dev","status":"live","title":"HARZ OMNINET — The Intent Fabric","fetched_at":"2026-10-08T06:49:04Z","size":7999,"html_sha256":"6ef84fb38f752cb038be22863f68a005cc40e21bcf8b790f75343d365307610b","html":"<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n<title>HARZ OMNINET — The Intent Fabric<\/title>\n<link rel=\"manifest\" href=\"/manifest.json\"><meta name=\"theme-color\" content=\"#f0f2f5\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<meta name=\"apple-mobile-web-app-title\" content=\"OMNINET\"><link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<link rel=\"icon\" href=\"/icon-192.png\" type=\"image/png\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f0f2f5;color:#1f2937}\n.wrap{max-width:680px;margin:0 auto;padding:24px 16px 40px}\nh1{font-size:1.6rem;color:#2563eb;margin-bottom:6px}\n.sub{color:#6b7280;font-size:.9rem;margin-bottom:18px}\ntextarea{width:100%;min-height:90px;border:1px solid #d1d5db;border-radius:10px;padding:12px;font-size:1rem;font-family:inherit;background:#fff;resize:vertical}\ntextarea:focus{outline:2px solid #2563eb;border-color:#2563eb}\nbutton{width:100%;margin-top:10px;background:#2563eb;color:#fff;border:0;border-radius:10px;padding:13px;font-size:1rem;font-weight:600;cursor:pointer}\nbutton:disabled{background:#93c5fd;cursor:wait}\nbutton.gray{background:#4b5563;margin-top:8px;font-size:.85rem;padding:9px}\nbutton.gray:disabled{background:#9ca3af}\n.panel{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:16px;margin-top:16px}\nh2{font-size:1rem;margin-bottom:10px}\n.node{display:inline-block;background:#f9fafb;border:1px solid #e5e7eb;border-radius:99px;padding:3px 10px;font-size:.75rem;margin:2px 4px 2px 0;color:#374151}\n.node.up{background:#ecfdf5;border-color:#a7f3d0;color:#065f46}\n.node.down{background:#fef2f2;border-color:#fecaca;color:#991b1b}\n.intent{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:16px;margin-top:14px}\n.goal{font-weight:600;font-size:1.02rem}\n.meta{color:#6b7280;font-size:.78rem;margin:4px 0 10px}\n.stage{display:inline-block;background:#f3f4f6;border:1px solid #e5e7eb;color:#6b7280;border-radius:99px;padding:2px 9px;font-size:.68rem;margin:2px 4px 2px 0}\n.stage.on{background:#dbeafe;border-color:#93c5fd;color:#1d4ed8}\n.stage.done{background:#ecfdf5;border-color:#a7f3d0;color:#065f46}\n.orch{color:#374151;font-size:.78rem;margin-top:10px;line-height:1.5}\n.outcome{margin-top:10px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:10px}\n.outcome a{color:#1d4ed8;font-weight:600;text-decoration:none;font-size:.9rem}\n.outcome .note{color:#6b7280;font-size:.78rem;margin-top:4px}\n.leadcount{color:#065f46;font-size:.78rem;margin-top:6px;font-weight:600}\n.empty{color:#9ca3af;text-align:center;padding:14px;font-size:.9rem}\nfooter{margin-top:22px;text-align:center;color:#9ca3af;font-size:.75rem}\n.link{color:#2563eb;text-decoration:none}\n<\/style><\/head><body><div class=\"wrap\">\n<h1>HARZ OMNINET<\/h1>\n<div class=\"sub\">The Intent Fabric — the world's first Outcome-as-a-Service network. Declare what you want. The fabric spawns a live outcome, delivers it, dissolves the stack when done.<\/div>\n<textarea id=\"goal\" placeholder=\"Declare an intent... e.g. House 200 people in Abuja under 50 million naira\"><\/textarea>\n<button id=\"declare\" onclick=\"declare()\">⚡ Declare Intent<\/button>\n<div class=\"panel\"><h2>The Fabric<\/h2><div id=\"fabric\"><span class=\"node\">checking...<\/span><\/div><\/div>\n<div id=\"intents\"><div class=\"empty\">Loading intents...<\/div><\/div>\n<footer>HARZ OMNINET v0.2.0 — Harz Ecosystem · powered by Harz Cloud<\/footer>\n<\/div>\n<script>\nconst STAGES = ['RECEIVED','ANALYZED','PLANNED','ORCHESTRATING','FULFILLED','DISSOLVED'];\nconst esc = s => String(s||'').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n\nasync function loadFabric(){\n  try{\n    const r = await fetch('/api/fabric'); const d = await r.json();\n    const el = document.getElementById('fabric');\n    el.innerHTML = Object.entries(d.fabric).map(([k,v]) => '<span class=\"node '+(v.status==='online'?'up':'down')+'\">'+k+(v.status==='online'?' ●':' ○')+'<\/span>').join('')\n      + '<div style=\"color:#6b7280;font-size:.75rem;margin-top:6px\">'+d.online+'/'+d.total+' nodes online<\/div>';\n  }catch(e){ document.getElementById('fabric').innerHTML = '<span class=\"node down\">fabric unreachable ○<\/span>'; }\n}\n\nasync function load(){\n  try{\n    const r = await fetch('/api/intents'); const d = await r.json();\n    const el = document.getElementById('intents');\n    if(!d.count){ el.innerHTML = '<div class=\"empty\">No intents yet — declare one above.<\/div>'; return; }\n    el.innerHTML = d.intents.map(i => {\n      const done = new Set(i.lifecycle.map(s => s.stage));\n      const stages = STAGES.map(s => '<span class=\"stage '+(s==='DISSOLVED'&&done.has('DISSOLVED')?'done':(done.has(s)?'on':''))+'\">'+s+'<\/span>').join('');\n      const svcs = (i.blueprint && i.blueprint.services || []).map(s => esc(typeof s === 'string' ? s : s.service)).join(', ');\n      const pat = i.blueprint ? esc(i.blueprint.genesis_pattern) : '';\n      const out = (i.outcome && i.outcome.spawned)\n        ? '<div class=\"outcome\"><a href=\"'+i.outcome.url+'\" target=\"_blank\">▶ Open live outcome: '+esc(i.outcome.title)+' →<\/a><div class=\"note\">'+esc(i.outcome.note)+'<\/div>'+(i.leads?'<div class=\"leadcount\">'+i.leads+' entries collected<\/div>':'')+'<\/div>'\n        : (i.outcome && i.outcome.note ? '<div class=\"orch\" style=\"color:#9ca3af\">'+esc(i.outcome.note)+'<\/div>' : '');\n      const canDissolve = i.status==='FULFILLED' && i.outcome && i.outcome.spawned;\n      return '<div class=\"intent\"><div class=\"goal\">'+esc(i.goal)+'<\/div>'\n        + '<div class=\"meta\">'+esc(i.id)+' · '+esc(i.domain)+' · '+esc(i.status)+'<\/div>'\n        + '<div>'+stages+'<\/div>'\n        + '<div class=\"orch\">Fabric nodes: '+(i.orchestration?i.orchestration.fabric_online.length:0)+'/'+(i.orchestration?i.orchestration.fabric_total:5)+' online · Pattern: '+pat+'<br>Services wired: '+svcs+'<\/div>'\n        + out\n        + (canDissolve ? '<button class=\"gray\" onclick=\"dissolve(&#39;'+i.id+'&#39;)\">Dissolve stack<\/button>' : '')\n        + '<\/div>';\n    }).join('');\n  }catch(e){ document.getElementById('intents').innerHTML = '<div class=\"empty\">Could not reach the fabric.<\/div>'; }\n}\n\nasync function declare(){\n  const btn = document.getElementById('declare');\n  const goal = document.getElementById('goal').value.trim();\n  if(!goal){ document.getElementById('goal').focus(); return; }\n  btn.disabled = true; btn.textContent = 'Receiving intent...';\n  try{\n    const r = await fetch('/api/intents', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ goal }) });\n    const d = await r.json();\n    if(!d.success){ btn.textContent='⚡ Declare Intent'; btn.disabled=false; return; }\n    btn.textContent = 'Orchestrating fabric...';\n    // poll until fulfilled or failed\n    for(let n=0;n<12;n++){\n      await new Promise(res => setTimeout(res, 1500));\n      const r2 = await fetch('/api/intents/'+d.intent.id); const d2 = await r2.json();\n      if(d2.intent.status==='FULFILLED'){ btn.textContent = '✓ Outcome live — see below'; load(); setTimeout(()=>{ btn.textContent='⚡ Declare Intent'; btn.disabled=false; document.getElementById('goal').value=''; }, 2500); return; }\n      if(d2.intent.status==='FAILED'){ btn.textContent='⚡ Declare Intent'; btn.disabled=false; load(); return; }\n    }\n    btn.textContent = '✓ Declared'; load();\n    setTimeout(()=>{ btn.textContent='⚡ Declare Intent'; btn.disabled=false; }, 2000);\n  }catch(e){ btn.textContent='⚡ Declare Intent'; btn.disabled=false; }\n}\n\nasync function dissolve(id){\n  const r = await fetch('/api/intents/'+id+'/dissolve', { method:'POST' });\n  const d = await r.json();\n  if(d.success) load();\n}\n\nloadFabric(); load();\nif ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(()=>{});\n<\/script><\/body><\/html>"},{"name":"Harz Platform","domain":"harz-platform.vercel.app","url":"https://harz-platform.vercel.app","status":"dead","title":"","fetched_at":"2026-10-08T06:49:04Z","size":107,"html_sha256":""},{"name":"Harz Quantum","domain":"harz-quantum.harz.workers.dev","url":"https://harz-quantum.harz.workers.dev","status":"live","title":"HARZ Quantum Lab - Quantum-Inspired Optimization","fetched_at":"2026-10-08T06:49:04Z","size":7923,"html_sha256":"1b442eb14a0ec44cf3711895381fee5df7f322f86a393033b6608b44e114a613","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#f0f2f5\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"HARZ Quantum\">\n<link rel=\"manifest\" href=\"/manifest.json\">\n<title>HARZ Quantum Lab - Quantum-Inspired Optimization<\/title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#f0f2f5;color:#1a1a2e;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;padding-bottom:40px}\nheader{background:linear-gradient(135deg,#4a148c,#311b92);color:#fff;padding:22px 16px;text-align:center}\nheader h1{font-size:20px}header p{font-size:13px;opacity:.85;margin-top:4px}\n.wrap{max-width:900px;margin:0 auto;padding:0 14px}\n.banner{background:#fff3cd;border:1px solid #ffe08a;border-radius:10px;padding:12px 16px;margin:14px 0;font-size:13px;color:#856404;line-height:1.5}\n.section{background:#fff;border-radius:14px;padding:20px;box-shadow:0 2px 10px rgba(0,0,0,.07);margin-bottom:16px}\n.section h3{font-size:16px;margin-bottom:14px;color:#4a148c}\n.grid{display:grid;grid-template-columns:1fr;gap:10px}\n@media(min-width:600px){.grid{grid-template-columns:1fr 1fr}}\n.algo-card{background:#f8f9fa;border-radius:10px;padding:14px;border:1px solid #eceef1}\n.algo-card h4{font-size:14px;color:#4a148c;margin-bottom:4px}\n.algo-card .type{font-size:11px;color:#888;text-transform:uppercase;margin-bottom:6px}\n.algo-card .desc{font-size:12px;color:#555;line-height:1.5}\n.algo-card .qubits{font-size:12px;color:#4a148c;font-weight:700;margin-top:4px}\n.run-btn{background:#4a148c;color:#fff;border:none;padding:6px 14px;border-radius:6px;font-size:12px;cursor:pointer;margin-top:6px}\n.exp-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #f0f0f0}\n.exp-row:last-child{border-bottom:none}\n.exp-name{font-size:13px;font-weight:600}\n.exp-status{font-size:12px;padding:2px 8px;border-radius:4px}\n.exp-status.completed{background:#e7f6ec;color:#0d4f3c}\n.exp-status.running{background:#fff3cd;color:#856404}\n.exp-result{font-size:12px;color:#888;margin-top:4px}\n.opt-form{margin-bottom:12px}\n.opt-input{width:100%;padding:10px;border:1px solid #e2e4e8;border-radius:8px;font-size:14px;background:#f8f9fa;margin-bottom:8px}\n.opt-btn{background:#4a148c;color:#fff;border:none;padding:10px 20px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;width:100%}\n.opt-result{background:#f8f9fa;border-radius:10px;padding:14px;margin-top:12px}\n.alloc-row{display:flex;justify-content:space-between;padding:4px 0;font-size:13px}\n.alloc-row b{color:#4a148c}\nfooter{text-align:center;font-size:12px;color:#999;margin-top:24px}\n<\/style>\n<\/head>\n<body>\n<header><h1>HARZ Quantum Lab<\/h1><p>Quantum-inspired optimization and experiment sandbox<\/p><\/header>\n<div class=\"wrap\">\n<div class=\"banner\"><b>Disclaimer:<\/b> These are quantum-inspired simulations running on classical hardware, not a real quantum computer. Results are approximations for research and education.<\/div>\n\n<div class=\"section\">\n<h3>Portfolio Optimizer<\/h3>\n<div class=\"opt-form\">\n<input class=\"opt-input\" id=\"assets\" placeholder=\"Enter assets (comma-separated): Banking, Telecom, Oil\">\n<button class=\"opt-btn\" onclick=\"optimize()\">Run QAOA Optimization<\/button>\n<\/div>\n<div id=\"optResult\"><\/div>\n<\/div>\n\n<div class=\"section\">\n<h3>Available Algorithms<\/h3>\n<div class=\"grid\" id=\"algosGrid\"><\/div>\n<\/div>\n\n<div class=\"section\">\n<h3>Recent Experiments<\/h3>\n<div id=\"expsList\"><\/div>\n<\/div>\n\n<\/div>\n<footer>HARZ Digital Services | Quantum Lab v2.0.0<br>Quantum-inspired simulations on classical hardware. For research and education.<\/footer>\n<script>\nvar ALGORITHMS = [{\"name\":\"QAOA\",\"full\":\"Quantum Approximate Optimization Algorithm\",\"type\":\"Combinatorial\",\"qubits\":8,\"desc\":\"Solves optimization problems by quantum-inspired annealing\"},{\"name\":\"VQE\",\"full\":\"Variational Quantum Eigensolver\",\"type\":\"Chemistry\",\"qubits\":12,\"desc\":\"Finds ground state energy of molecules\"},{\"name\":\"Grover\",\"full\":\"Grover's Search\",\"type\":\"Search\",\"qubits\":10,\"desc\":\"Quadratic speedup for unstructured search\"},{\"name\":\"Shor\",\"full\":\"Shor's Factoring\",\"type\":\"Cryptography\",\"qubits\":20,\"desc\":\"Quantum factoring of integers (simulated)\"},{\"name\":\"QNN\",\"full\":\"Quantum Neural Network\",\"type\":\"ML\",\"qubits\":6,\"desc\":\"Quantum-enhanced machine learning model\"},{\"name\":\"QSim\",\"full\":\"Quantum Circuit Simulator\",\"type\":\"Simulation\",\"qubits\":16,\"desc\":\"Simulates arbitrary quantum circuits\"}];\nvar EXPERIMENTS = [{\"id\":\"exp_001\",\"name\":\"Portfolio Optimization (Nigerian Stocks)\",\"algo\":\"QAOA\",\"status\":\"completed\",\"result\":\"Optimal allocation: 35% banking, 25% telecom, 20% oil & gas, 20% consumer goods\",\"runtime_ms\":1240,\"created\":\"2026-08-20\"},{\"id\":\"exp_002\",\"name\":\"HARZ Token Price Prediction\",\"algo\":\"QNN\",\"status\":\"completed\",\"result\":\"Bullish signal detected for next 7 days (72% confidence)\",\"runtime_ms\":890,\"created\":\"2026-08-21\"},{\"id\":\"exp_003\",\"name\":\"Supply Chain Route Optimization\",\"algo\":\"QAOA\",\"status\":\"running\",\"result\":\"Processing 256 routes...\",\"runtime_ms\":0,\"created\":\"2026-08-24\"},{\"id\":\"exp_004\",\"name\":\"Molecular Bond Energy (H2O)\",\"algo\":\"VQE\",\"status\":\"completed\",\"result\":\"Ground state: -5.123 eV (matches known value)\",\"runtime_ms\":2100,\"created\":\"2026-08-22\"}];\nfunction renderAlgos(){var html=\"\";for(var i=0;i<ALGORITHMS.length;i++){var a=ALGORITHMS[i];html+='<div class=\"algo-card\"><h4>'+a.name+'<\/h4><div class=\"type\">'+a.type+'<\/div><div class=\"desc\">'+a.desc+'<\/div><div class=\"qubits\">'+a.qubits+' qubits<\/div><button class=\"run-btn\" onclick=\"runAlgo(\\''+a.name+'\\')\">Run<\/button><\/div>'}document.getElementById(\"algosGrid\").innerHTML=html}\nfunction renderExps(){var html=\"\";for(var i=0;i<EXPERIMENTS.length;i++){var e=EXPERIMENTS[i];html+='<div class=\"exp-row\"><div><div class=\"exp-name\">'+e.name+'<\/div><div class=\"exp-result\">'+e.result+'<\/div><\/div><span class=\"exp-status '+e.status+'\">'+e.status+'<\/span><\/div>'}document.getElementById(\"expsList\").innerHTML=html}\nasync function optimize(){var assets=document.getElementById(\"assets\").value;if(!assets)return;var arr=assets.split(\",\").map(function(s){return s.trim()});var el=document.getElementById(\"optResult\");el.innerHTML='<div style=\"padding:14px;color:#888\">Running QAOA optimization...<\/div>';try{var r=await fetch(\"/api/optimize\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({assets:arr})});var d=await r.json();if(d.success){var html='<div class=\"opt-result\"><div style=\"font-size:13px;font-weight:600;margin-bottom:8px;color:#4a148c\">Optimal Allocation:<\/div>';for(var i=0;i<d.allocations.length;i++){html+='<div class=\"alloc-row\"><span>'+d.allocations[i].asset+'<\/span><b>'+d.allocations[i].weight+'%<\/b><\/div>'}html+='<div style=\"margin-top:10px;font-size:12px;color:#888\">Expected return: '+d.expected_return+' | Risk score: '+d.risk_score+'<\/div>';html+='<div style=\"font-size:11px;color:#aaa;margin-top:6px\">'+d.disclaimer+'<\/div>';el.innerHTML=html}else{el.innerHTML='<div style=\"color:red;padding:14px\">'+d.error+'<\/div>'}}catch(e){el.innerHTML='<div style=\"color:red;padding:14px\">Error<\/div>'}}\nasync function runAlgo(name){var problem=prompt(\"Describe the problem to solve:\");if(!problem)return;try{var r=await fetch(\"/api/run\",{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify({algorithm:name,problem:problem})});var d=await r.json();if(d.success){alert(\"Experiment \"+d.experiment.id+\"\\nResult: \"+d.experiment.result+\"\\nRuntime: \"+d.experiment.runtime_ms+\"ms\\n\\n\"+d.disclaimer)}}catch(e){alert(\"Error running experiment\")}}\nrenderAlgos();renderExps();if(\"serviceWorker\"in navigator)navigator.serviceWorker.register(\"/sw.js\").catch(function(){});\n<\/script>\n<\/body>\n<\/html>"},{"name":"Harz Realestate","domain":"harz-realestate.harz.workers.dev","url":"https://harz-realestate.harz.workers.dev","status":"live","title":"HARZ Estate Network","fetched_at":"2026-10-08T06:49:04Z","size":10477,"html_sha256":"612766bfd20003e8506df9098ae932b2c946e98bd30b106bdb83114d4442d7e6","html":"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#33691e\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-title\" content=\"HARZ Estate\"><meta name=\"description\" content=\"HARZ Property & Estate Network\"><link rel=\"manifest\" href=\"/manifest.json\"><link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\"><title>HARZ Estate Network<\/title><style>*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,-apple-system,sans-serif}body{background:#f5f5f5;color:#1a1a2e;padding:env(safe-area-inset-top) 12px env(safe-area-inset-bottom)}:root{--pri:#33691e;--acc:#558b2f;--card:#fff;--bdr:#e0e0e0;--grn:#2e7d32}.hd{padding:16px 0 8px;text-align:center;position:sticky;top:0;background:#f5f5f5;z-index:10;border-bottom:1px solid var(--bdr)}.hd h1{font-size:22px;color:var(--pri);font-weight:800}.hd p{font-size:11px;color:#666;margin-top:2px}.badge{display:inline-block;background:#e8f5e9;color:var(--pri);padding:2px 10px;border-radius:12px;font-size:10px;margin-top:4px}.stats{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;margin:10px 0}.stat{background:var(--card);border:1px solid var(--bdr);border-radius:10px;padding:10px 6px;text-align:center}.stat .n{font-size:18px;font-weight:800;color:var(--pri)}.stat .l{font-size:9px;color:#666;margin-top:2px}.tabs{display:flex;gap:4px;margin:10px 0;overflow-x:auto;padding-bottom:4px}.tab{padding:8px 14px;border-radius:8px;font-size:12px;font-weight:600;color:#666;background:var(--card);border:1px solid var(--bdr);white-space:nowrap;cursor:pointer}.tab.active{background:var(--pri);color:#fff;border-color:var(--pri)}.section{display:none}.section.active{display:block}.card{background:var(--card);border:1px solid var(--bdr);border-radius:12px;padding:14px;margin:8px 0;cursor:pointer}.card:active{transform:scale(.98)}.card h3{font-size:14px;margin-bottom:4px}.card .meta{font-size:11px;color:#666;display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}.price{font-size:16px;font-weight:800;color:var(--grn)}.tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:600}.tag-sale{background:#e8f5e9;color:var(--grn)}.tag-rent{background:#e8eaf6;color:#1a237e}.tag-land{background:#fff3e0;color:#e65100}.btn{display:block;width:100%;padding:12px;background:var(--pri);color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;margin:10px 0}.btn-out{background:transparent;color:var(--pri);border:2px solid var(--pri)}.input{width:100%;padding:10px 12px;border:1px solid var(--bdr);border-radius:8px;font-size:14px;margin:6px 0;outline:none;background:#fff}.label{font-size:12px;font-weight:600;color:#333;margin-top:8px;display:block}.search{width:100%;padding:10px 14px;background:#fff;border:1px solid var(--bdr);border-radius:10px;font-size:14px;margin:10px 0;outline:none}.empty{text-align:center;padding:40px 20px;color:#999}.foot{text-align:center;padding:20px 0;font-size:10px;color:#999}.modal-bg{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);display:none;z-index:100;justify-content:center;align-items:flex-end}.modal-bg.show{display:flex}.modal{background:#fff;width:100%;max-width:500px;border-radius:16px 16px 0 0;max-height:8