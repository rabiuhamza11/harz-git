  var term = $("findbox").value.trim();
  if (!term){ body.textContent = BYID_CURRENT.text; HL = []; $("findcount").textContent=""; return; }
  var text = BYID_CURRENT.text;
  var low = text.toLowerCase(), t = term.toLowerCase(), pos = [], p = -1;
  while ((p = low.indexOf(t, p+1)) > -1) pos.push(p);
  if (!pos.length){ $("findcount").textContent = "0 matches"; return; }
  var frag = document.createDocumentFragment(), cur = 0;
  for (var i = 0; i < pos.length; i++){
    frag.appendChild(document.createTextNode(text.slice(cur, pos[i])));
    var m = document.createElement("mark"); m.className = "hl"; m.id = "hl" + i;
    m.textContent = text.slice(pos[i], pos[i] + t.length);
    frag.appendChild(m); cur = pos[i] + t.length;
  }
  frag.appendChild(document.createTextNode(text.slice(cur)));
  body.textContent = ""; body.appendChild(frag);
  HL = pos;
  $("findcount").textContent = pos.length + " matches";
  jumpTo(0);
}
var HLIDX = 0;
function jumpTo(i){
  if (!HL.length){ $("findcount").textContent = "Type a word and press FIND first"; return; }
  HLIDX = (i + HL.length) % HL.length;
  var el = $("hl" + HLIDX);
  if (el && el.scrollIntoView) el.scrollIntoView({block:"center"});
  $("findcount").textContent = (HLIDX+1) + " of " + HL.length;
}
function backToSearch(){
  $("article").style.display = "none";
  $("searchview").style.display = "block";
}
function goHome(){
  $("article").style.display = "none";
  $("appview").style.display = "none";
  $("searchview").style.display = "block";
  window.scrollTo(0,0);
}
// ---- page navigation: walk the current list (search results or site pages) ----
var VIEW_LIST = [];
function navArticle(dir){
  if (!VIEW_LIST.length){ window.scrollTo(0,0); return; }
  var idx = VIEW_LIST.indexOf(BYID_CURRENT ? BYID_CURRENT.id : -1);
  if (idx < 0) idx = 0;
  var n = (idx + dir + VIEW_LIST.length) % VIEW_LIST.length;
  openArticle(VIEW_LIST[n]);
}
// ---- HARZ APPS (offline shell snapshots — a cached shell is never the live app) ----
var APPS = null;
function appsData(){
  if (APPS) return APPS;
  try { APPS = JSON.parse(document.getElementById("src-apps").textContent); }
  catch(e){ APPS = { apps: [] }; }
  return APPS;
}
function listApps(){
  var d = appsData();
  var box = $("siteres"); box.innerHTML = "";
  var live = 0;
  for (var i = 0; i < d.apps.length; i++) if (d.apps[i].status === "live") live++;
  $("siteinfo").textContent = "HARZ ecosystem: " + live + " apps with offline shells + " + (d.apps.length - live) + " dead links recorded honestly. Shells open offline; live data still needs internet.";
  var idx = 0;
  for (var i2 = 0; i2 < d.apps.length; i2++){
    (function(app, k){
      if (app.status !== "live"){ idx++; return; }
      var el = document.createElement("div"); el.className = "res";
      var hh = document.createElement("h3"); hh.textContent = app.name;
      hh.onclick = function(){ openApp(k); };
      var dm = document.createElement("div"); dm.className = "dom";
      dm.textContent = app.domain + " · shell " + Math.round((app.size||0)/1024) + "KB · snapshotted " + (app.fetched_at||"?").slice(0,10);
      el.appendChild(hh); el.appendChild(dm); box.appendChild(el);
    })(d.apps[i2], i2);
  }
  var dead = document.createElement("div"); dead.className = "small";
  dead.textContent = (d.apps.length - live) ? ((d.apps.length - live) + " dead links recorded — never faked.") : "";
  if (dead.textContent) box.appendChild(dead);
}
function openApp(k){
  var app = appsData().apps[k];
  if (!app || !app.html) return;
  $("app-title").textContent = app.name;
  $("app-meta").innerHTML =
    '<span class="badge b-warn">OFFLINE SHELL — snapshot ' + (app.fetched_at||"?").slice(0,10) + ', not the live app</span>'
    + '<span class="badge b-info">' + app.domain + '</span>';
  var holder = $("app-frame-holder"); holder.innerHTML = "";
  var f = document.createElement("iframe");
  f.setAttribute("sandbox", "allow-scripts allow-forms allow-same-origin allow-modals");
  f.style.cssText = "width:100%;height:70vh;border:0;background:#fff";
  f.srcdoc = app.html;
  holder.appendChild(f);
  $("searchview").style.display = "none";
  $("article").style.display = "none";
  $("appview").style.display = "block";
  window.scrollTo(0,0);
}
function closeApp(){
  $("appview").style.display = "none";
  $("searchview").style.display = "block";
}
// hide appview initially (template shows it)
// ---- offline browser bar (additive UI — frozen engine and seals untouched) ----
function siteFromInput(v){
  v = (v||"").trim().toLowerCase();
  v = v.replace(/^[a-z]+:\/\//, "");
  v = v.split(/[\/?#]/)[0];
  v = v.replace(/^www\./, "");
  return v;
}
function openSite(){
  var dom = siteFromInput($("siteq").value);
  var box = $("siteres"); box.innerHTML = "";
  if (!dom){ $("siteinfo").textContent = "Type a website first — e.g. punchng.com"; return; }
  var hits = [];
  for (var i = 0; i < DOCS.length; i++){
    if ((DOCS[i].domain||"").replace(/^www\./,"") === dom) hits.push(DOCS[i]);
  }
  if (!hits.length){
    var near = [];
    for (var j = 0; j < DOCS.length && near.length < 4; j++){
      var d = (DOCS[j].domain||"").replace(/^www\./,"");
      if (d.indexOf(dom) > -1 || dom.indexOf(d) > -1) near.push(d);
    }
    $("siteinfo").textContent = "Nothing gathered from " + dom + " yet — the offline library holds only what HARZ has gathered. " + (near.length ? "Closest held: " + near.join(", ") + ". " : "") + "Any site in the world can be requested into the library:";
    var rq = document.createElement("button");
    rq.className = "cta";
    rq.style.cssText = "display:block;margin:8px 0;padding:10px 16px;font-size:15px";
    rq.textContent = "REQUEST " + dom + " FOR OFFLINE GATHERING";
    rq.onclick = function(){ requestGather(dom, rq); };
    box.appendChild(rq);
    return;
  }
  hits.sort(function(a,b){ return (b.fetched_at||"").localeCompare(a.fetched_at||""); });
  VIEW_LIST = hits.map(function(d){ return d.id; });
  $("siteinfo").textContent = hits.length + " pages from " + dom + " held offline — full text, no truncation";
  for (var k = 0; k < Math.min(hits.length, 60); k++){
    (function(d){
      var el = document.createElement("div"); el.className = "res";
      var hh = document.createElement("h3"); hh.textContent = d.title; hh.onclick = function(){ openArticle(d.id); };
      var dm = document.createElement("div"); dm.className = "dom";
      dm.textContent = "cached " + (d.fetched_at||"?") + " · " + d.text.length.toLocaleString() + " chars full text";
      el.appendChild(hh); el.appendChild(dm); box.appendChild(el);
    })(hits[k]);
  }
  if (hits.length > 60){
    var more = document.createElement("div"); more.className = "small";
    more.textContent = "+" + (hits.length-60) + " more — use SEARCH to explore them.";
    box.appendChild(more);
  }
}
function requestGather(dom, btn){
  btn.disabled = true;
  btn.textContent = "Requesting...";
  if (!navigator.onLine){ btn.textContent = "You are OFFLINE — requests need a little data. Try again when online."; return; }
  fetch("/gather?d=" + encodeURIComponent(dom))
    .then(function(r){ return r.json(); })
    .then(function(j){
      if (j.ok){ btn.textContent = "QUEUED (position " + (j.position||"?") + ") — the 03:30 WAT worldwide wave gathers " + dom + ". It lands in your library after the next seal."; btn.style.background = "#117045"; btn.style.color = "#fff"; }
      else { btn.textContent = "Could not queue: " + (j.error||"unknown"); btn.disabled = false; }
    })
    .catch(function(){ btn.textContent = "Request needs the cloud link (a little data): https://harz-offline-browser.hamzarabiu390.workers.dev"; btn.disabled = false; });
}
function listSites(){
  var counts = Object.create(null);
  for (var i = 0; i < DOCS.length; i++){
    var d = (DOCS[i].domain||"?").replace(/^www\./,"");
    counts[d] = (counts[d]||0) + 1;
  }
  var keys = Object.keys(counts).sort(function(a,b){ return counts[b]-counts[a]; });
  var box = $("siteres"); box.innerHTML = "";
  $("siteinfo").textContent = "Offline library holds pages from " + keys.length + " websites:";
  for (var j = 0; j < Math.min(keys.length, 80); j++){
    (function(d){
      var el = document.createElement("div"); el.className = "res";
      var hh = document.createElement("h3"); hh.textContent = d + " (" + counts[d] + ")";
      hh.onclick = function(){ $("siteq").value = d; openSite(); };
      var dm = document.createElement("div"); dm.className = "dom"; dm.textContent = "open offline";
      el.appendChild(hh); el.appendChild(dm); box.appendChild(el);
    })(keys[j]);
  }
}
document.addEventListener("DOMContentLoaded", function(){ document.getElementById("appview").style.display = "none"; boot(); });

</script>
