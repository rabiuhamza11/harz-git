function exportIndex(index, docs, crawlMeta) {
  var payload = {
    format: "HARZSEARCH-INDEX",
    version: "0.1",
    exported_at: crawlMeta ? crawlMeta.exported_at : null,
    crawl: { last_crawl: crawlMeta ? crawlMeta.last_crawl : null },
