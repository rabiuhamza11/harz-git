:var(--muted);font-size:12px;margin-top:4px;text-transform:uppercase;letter-spacing:.5px}\n.stat-icon{font-size:20px;float:right;opacity:.5}\n\n/* Section */\n.section{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:20px}\n.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}\n.section-title{font-size:15px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:8px}\n.section-title .ico{font-size:18px}\n.btn{padding:9px 18px;border-radius:10px;border:none;font-size:13px;font-weight:600;cursor:pointer;transition:.2s;display:inline-flex;align-items:center;gap:6px}\n.btn-primary{background:linear-gradient(135deg,var(--primary),#8b70ff);color:#fff}\n.btn-primary:hover{box-shadow:0 0 16px var(--primary-glow);transform:translateY(-1px)}\n.btn-outline{background:transparent;border:1px solid var(--border);color:var(--text)}\n.btn-outline:hover{border-color:var(--primary);background:var(--card-hover)}\n.btn-danger{background:var(--error-bg);color:var(--error);border:1px solid rgba(239,68,68,.2)}\n.btn-sm{padding:6px 12px;font-size:12px}\n\n/* Platforms Grid */\n.platforms-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}\n.platform-card{background:var(--card-hover);border:1px solid var(--border);border-radius:12px;padding:18px;text-align:center;transition:.3s;cursor:pointer}\n.platform-card:hover{border-color:var(--primary);transform:translateY(-2px)}\n.platform-icon{font-size:32px;margin-bottom:8px}\n.platform-name{font-size:13px;font-weight:600;color:var(--text)}\n.platform-status{font-size:11px;margin-top:6px;padding:3px 10px;border-radius:20px;display:inline-block}\n.status-connected{background:var(--success-bg);color:var(--success)}\n.status-offline{background:rgba(122,127,142,.1);color:var(--muted)}\n.platform-deploys{font-size:11px;color:var(--muted);margin-top:8px}\n\n/* Deploy Form */\n.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.form-group{margin-bottom:14px}\n.form-group.full{grid-column:1/-1}\nlabel{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:500}\ninput,select,textarea{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 14px;color:var(--text);font-size:13px;font-family:inherit;transition:.2s}\ninput:focus,select:focus,textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-glow)}\ntextarea{resize:vertical;min-height:80px}\n.chip-group{display:flex;flex-wrap:wrap;gap:8px}\n.chip{padding:6px 14px;border-radius:20px;border:1px solid var(--border);font-size:12px;cursor:pointer;transition:.2s;color:var(--muted)}\n.chip.active{background:var(--primary);color:#fff;border-color:var(--primary)}\n.chip:hover{border-color:var(--primary)}\n\n/* Deploy History */\n.history-table{width:100%;border-collapse:collapse}\n.history-table th{text-align:left;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;padding:8px 12px;border-bottom:1px solid var(--border)}\n.history-table td{padding:12px;font-size:13px;border-bottom:1px solid rgba(108,92,231,.06)}\n.history-table tr:hover{background:var(--card-hover)}\n.badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:500;display:inline-block}\n.badge-live{background:var(--success-bg);color:var(--success)}\n.badge-building{background:var(--warn-bg);color:var(--warn)}\n.badge-failed{background:var(--error-bg);color:var(--error)}\n.badge-dev{background:rgba(122,127,142,.1);color:var(--muted)}\n\n/* Tabs */\n.tabs{display:flex;gap:4px;margin-bottom:20px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:4px}\n.tab{flex:1;padding:10px;text-align:center;font-size:13px;font-weight:500;color:var(--muted);border-radius:8px;cursor:pointer;transition:.2s}\n.tab.active{background:var(--primary);color:#fff}\n\n/* Modal */\n.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;justify-content:center;align-items:center;padding:16px}\n.modal-overlay.active{display:flex}\n.modal{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;max-width:500px;width:100%;max-height:80vh;overflow-y:auto}\n.modal-title{font-size:16px;font-weight:600;margin-bottom:16px;display:flex;align-items:center;gap:8px}\n.modal-close{float:right;cursor:pointer;color:var(--muted);font-size:18px;background:none;border:none}\n.modal-close:hover{color:var(--text)}\n\n/* Deploy Log */\n.log-container{background:#0d0e16;border:1px solid var(--border);border-radius:10px;padding:14px;max-height:300px;overflow-y:auto;font-family:'SF Mono',Monaco,monospace;font-size:12px;line-height:1.8}\n.log-entry{color:var(--muted)}\n.log-entry.success{color:var(--success)}\n.log-entry.error{color:var(--error)}\n.log-entry.info{color:var(--cyan)}\n.log-time{color:var(--muted);opacity:.6}\n\n/* Toast */\n.toast{position:fixed;bottom:24px;right:24px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 20px;font-size:13px;z-index:300;transform:translateY(100px);opacity:0;transition:.3s;display:flex;align-items:center;gap:10px}\n.toast.show{transform:translateY(0);opacity:1}\n.toast.success{border-color:var(--success)}\n.toast.error{border-color:var(--error)}\n\n/* Responsive */\n@media(max-width:768px){\n.stats-grid{grid-template-columns:repeat(2,1fr)}\n.platforms-grid{grid-template-columns:repeat(2,1fr)}\n.form-grid{grid-template-columns:1fr}\n}\n<\/style>\n<\/head>\n<body>\n\n<!-- Header -->\n<div class=\"header\">\n<div class=\"logo\">\n<span class=\"logo-icon\">🚀<\/span>\n<span class=\"logo-text\">DeployForge<\/span>\n<span style=\"font-size:11px;color:var(--muted);margin-left:4px\">v10<\/span>\n<\/div>\n<div class=\"header-right\">\n<div class=\"status-dot\" id=\"systemStatus\"><\/div>\n<span style=\"font-size:12px;color:var(--muted)\" id=\"statusText\">All Systems Operational<\/span>\n<a href=\"https://rabiuhamza11.github.io/harz-portfolio/harz-super-app-v5.html\" class=\"header-link\">← HARZ Super App<\/a>\n<\/div>\n<\/div>\n\n<div class=\"main\">\n\n<!-- Stats Grid -->\n<div class=\"stats-grid\">\n<div class=\"stat-card\">\n<span class=\"stat-icon\">📦<\/span>\n<div class=\"stat-num\" id=\"statTotal\">—<\/div>\n<div class=\"stat-label\">Total Deployments<\/div>\n<\/div>\n<div class=\"stat-card\">\n<span class=\"stat-icon\">✅<\/span>\n<div class=\"stat-num\" id=\"statLive\" style=\"color:var(--success)\">—<\/div>\n<div class=\"stat-label\">Live<\/div>\n<\/div>\n<div class=\"stat-card\">\n<span class=\"stat-icon\">🔄<\/span>\n<div class=\"stat-num\" id=\"statBuilding\" style=\"color:var(--warn)\">—<\/div>\n<div class=\"stat-label\">Building<\/div>\n<\/div>\n<div class=\"stat-card\">\n<span class=\"stat-icon\">❌<\/span>\n<div class=\"stat-num\" id=\"statFailed\" style=\"color:var(--error)\">—<\/div>\n<div class=\"stat-label\">Failed<\/div>\n<\/div>\n<\/div>\n\n<!-- Tabs -->\n<div class=\"tabs\">\n<div class=\"tab active\" onclick=\"showTab('platforms')\">🖥️ Platforms<\/div>\n<div class=\"tab\" onclick=\"showTab('deploy')\">🚀 New Deploy<\/div>\n<div class=\"tab\" onclick=\"showTab('history')\">📋 History<\/div>\n<\/div>\n\n<!-- Tab: Platforms -->\n<div id=\"tab-platforms\" class=\"tab-content\">\n<div class=\"section\">\n<div class=\"section-header\">\n<div class=\"section-title\"><span class=\"ico\">🔗<\/span> Connected Platforms<\/div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"refreshPlatforms()\">↻ Refresh<\/button>\n<\/div>\n<div class=\"platforms-grid\" id=\"platformsGrid\"><\/div>\n<\/div>\n\n<div class=\"section\">\n<div class=\"section-header\">\n<div class=\"section-title\"><span class=\"ico\">📊<\/span> GitHub Repositories<\/div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"refreshRepos()\">↻ Refresh<\/button>\n<\/div>\n<div id=\"reposList\"><\/div>\n<\/div>\n\n<div class=\"section\">\n<div class=\"section-header\">\n<div class=\"section-title\"><span class=\"ico\">⚡<\/span> Vercel Projects<\/div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"refreshVercel()\">↻ Refresh<\/button>\n<\/div>\n<div id=\"vercelList\"><\/div>\n<\/div>\n<\/div>\n\n<!-- Tab: New Deploy -->\n<div id=\"tab-deploy\" class=\"tab-content\" style=\"display:none\">\n<div class=\"section\">\n<div class=\"section-header\">\n<div class=\"section-title\"><span class=\"ico\">🚀<\/span> Launch New Deployment<\/div>\n<\/div>\n<div class=\"form-grid\">\n<div class=\"form-group\">\n<label>Project Name<\/label>\n<input type=\"text\" id=\"projName\" placeholder=\"my-awesome-app\" />\n<\/div>\n<div class=\"form-group\">\n<label>Framework<\/label>\n<select id=\"projFramework\">\n<option value=\"nextjs\">Next.js<\/option>\n<option value=\"react\">React<\/option>\n<option value=\"vue\">Vue<\/option>\n<option value=\"static\">Static HTML<\/option>\n<option value=\"nuxtjs\">Nuxt.js<\/option>\n<option value=\"svelte\">Svelte<\/option>\n<\/select>\n<\/div>\n<div class=\"form-group full\">\n<label>Description<\/label>\n<input type=\"text\" id=\"projDesc\" placeholder=\"What does this app do?\" />\n<\/div>\n<div class=\"form-group full\">\n<label>Target Platforms<\/label>\n<div class=\"chip-group\">\n<div class=\"chip active\" data-platform=\"github\" onclick=\"toggleChip(this)\">🐙 GitHub<\/div>\n<div class=\"chip active\" data-platform=\"vercel\" onclick=\"toggleChip(this)\">▲ Vercel<\/div>\n<div class=\"chip\" data-platform=\"render\" onclick=\"toggleChip(this)\">⚡ Render<\/div>\n<div class=\"chip\" data-platform=\"netlify\" onclick=\"toggleChip(this)\">🌐 Netlify<\/div>\n<div class=\"chip\" data-platform=\"railway\" onclick=\"toggleChip(this)\">🚂 Railway<\/div>\n<\/div>\n<\/div>\n<div class=\"form-group full\">\n<label>Environment Variables (JSON)<\/label>\n<textarea id=\"projEnvVars\" placeholder='{\"API_KEY\": \"xxx\", \"DATABASE_URL\": \"postgres://...\"}'><\/textarea>\n<\/div>\n<div class=\"form-group\">\n<label>Private Repo<\/label>\n<select id=\"projPrivate\">\n<option value=\"false\">Public<\/option>\n<option value=\"true\">Private<\/option>\n<\/select>\n<\/div>\n<div class=\"form-group\">\n<label>Auto Deploy<\/label>\n<select id=\"projAutoDeploy\">\n<option value=\"true\">Yes — deploy after push<\/option>\n<option value=\"false\">No — just push code<\/option>\n<\/select>\n<\/div>\n<\/div>\n<div style=\"margin-top:16px;display:flex;gap:10px\">\n<button class=\"btn btn-primary\" onclick=\"launchDeploy()\">🚀 Launch Deployment<\/button>\n<button class=\"btn btn-outline\" onclick=\"resetForm()\">Reset<\/button>\n<\/div>\n<\/div>\n\n<!-- Deploy Log -->\n<div class=\"section\" id=\"deployLogSection\" style=\"display:none\">\n<div class=\"section-header\">\n<div class=\"section-title\"><span class=\"ico\">📜<\/span> Deployment Logs<\/div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"clearLog()\">Clear<\/button>\n<\/div>\n<div class=\"log-container\" id=\"deployLog\"><\/div>\n<\/div>\n<\/div>\n\n<!-- Tab: History -->\n<div id=\"tab-history\" class=\"tab-content\" style=\"display:none\">\n<div class=\"section\">\n<div class=\"section-header\">\n<div class=\"section-title\"><span class=\"ico\">📋<\/span> Deployment History<\/div>\n<button class=\"btn btn-outline btn-sm\" onclick=\"refreshHistory()\">↻ Refresh<\/button>\n<\/div>\n<div id=\"historyContainer\"><\/div>\n<\/div>\n<\/div>\n\n<\/div>\n\n<!-- Toast -->\n<div class=\"toast\" id=\"toast\">\n<span id=\"toastIcon\">✅<\/span>\n<span id=\"toastMsg\">Done!<\/span>\n<\/div>\n\n<script>\n// ===== Config =====\nconst API_BASE = ''; // Same origin on Vercel — /api/deployforge*\nconst HARZ_CLOUD = 'https://harz-cloud-backend.onrender.com';\n\n// ===== Local Data =====\nconst PLATFORMS = [\n{ name: 'GitHub', icon: '🐙', connected: true, deploys: 61, url: 'https://github.com/rabiuhamza11' },\n{ name: 'Vercel', icon: '▲', connected: true, deploys: 35, url: 'https://vercel.com' },\n{ name: 'Render', icon: '⚡', connected: true, deploys: 2, url: 'https://render.com' },\n{ name: 'Netlify', icon: '🌐', connected: false, deploys: 0, url: 'https://netlify.com' },\n{ name: 'Railway', icon: '🚂', connected: false, deploys: 0, url: 'https://railway.app' },\n];\n\nconst SAMPLE_DEPLOYS = [\n{ id: 1, project: 'HarzDM Marketplace', framework: 'nextjs', status: 'live', github: 'pushed', vercel: 'ready', url: 'harzdm-marketplace.vercel.app', date: '2026-08-04 10:42' },\n{ id: 2, project: 'MindCare AI', framework: 'react', status: 'live', github: 'pushed', vercel: 'ready', url: 'mindcare-ai.vercel.app', date: '2026-08-04 10:42' },\n{ id: 3, project: 'TradeOS', framework: 'nextjs', status: 'live', github: 'pushed', vercel: 'ready', url: 'tradeos.vercel.app', date: '2026-08-04 10:42' },\n{ id: 4, project: 'HarzPay', framework: 'nextjs', status: 'live', github: 'pushed', vercel: 'ready', url: 'harzpay.vercel.app', date: '2026-08-04 10:42' },\n{ id: 5, project: 'HarzMusic', framework: 'react', status: 'live', github: 'pushed', vercel: 'ready', url: 'harz-music.vercel.app', date: '2026-08-04 10:42' },\n{ id: 6, project: 'HarzFilm', framework: 'react', status: 'live', github: 'pushed', vercel: 'ready', url: 'harz-film.vercel.app', date: '2026-08-04 10:42' },\n{ id: 7, project: 'HARZ Cloud', framework: 'nextjs', status: 'building', github: 'pushed', vercel: 'building', url: 'harz-cloud-backend.onrender.com', date: '2026-08-04 11:08' },\n];\n\nconst SAMPLE_REPOS = [\n{ name: 'harz-portfolio', lang: 'HTML', url: 'https://github.com/rabiuhamza11/harz-portfolio', updated: '2026-08-04' },\n{ name: 'deployforge', lang: 'TypeScript', url: 'https://github.com/rabiuhamza11/deployforge', updated: '2026-08-04' },\n{ name: 'harz-ecosystem-app', lang: 'HTML', url: 'https://github.com/rabiuhamza11/harz-ecosystem-app', updated: '2026-08-04' },\n{ name: 'omega-commander-bot', lang: 'JavaScript', url: 'https://github.com/rabiuhamza11/omega-commander-bot', updated: '2026-08-04' },\n{ name: 'omega-ai-packager', lang: 'TypeScript', url: 'https://github.com/rabiuhamza11/omega-ai-packager', updated: '2026-08-04' },\n];\n\nconst SAMPLE_VERCEL = [\n{ name: 'mindcare-ai', framework: 'nextjs', url: 'mindcare-ai.vercel.app' },\n{ name: 'cyber-shield-x', framework: 'nextjs', url: 'cyber-shield-x.vercel.app' },\n{ name: 'tradeos', framework: 'nextjs', url: 'tradeos.vercel.app' },\n{ name: 'harzpay', framework: 'nextjs', url: 'harzpay.vercel.app' },\n{ name: 'harzdm-marketplace', framework: 'nextjs', url: 'harzdm-marketplace.vercel.app' },\n{ name: 'harz-music', framework: 'react', url: 'harz-music.vercel.app' },\n{ name: 'harz-film', framework: 'react', url: 'harz-film.vercel.app' },\n{ name: 'deployforge', framework: 'nextjs', url: 'deployforge.vercel.app' },\n];\n\n// ===== Tab Navigation =====\nfunction showTab(tab) {\ndocument.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\ndocument.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');\ndocument.getElementById('tab-' + tab).style.display = 'block';\nevent.target.classList.add('active');\n}\n\n// ===== Render Platforms =====\nfunction renderPlatforms() {\nconst grid = document.getElementById('platformsGrid');\ngrid.innerHTML = PLATFORMS.map(p => `\n<div class=\"platform-card\" onclick=\"window.open('${p.url}','_blank')\">\n<div class=\"platform-icon\">${p.icon}<\/div>\n<div class=\"platform-name\">${p.name}<\/div>\n<div class=\"platform-status ${p.connected ? 'status-connected' : 'status-offline'}\">\n${p.connected ? '● Connected' : '○ Not Connected'}\n<\/div>\n<div class=\"platform-deploys\">${p.deploys} deployments<\/div>\n<\/div>\n`).join('');\n}\n\n// ===== Render Repos =====\nfunction renderRepos() {\nconst list = document.getElementById('reposList');\nlist.innerHTML = `<table class=\"history-table\">\n<thead><tr><th>Repository<\/th><th>Language<\/th><th>Last Updated<\/th><th><\/th><\/tr><\/thead>\n<tbody>\n${SAMPLE_REPOS.map(r => `\n<tr>\n<td><a href=\"${r.url}\" target=\"_blank\" style=\"color:var(--cyan);text-decoration:none\">${r.name}<\/a><\/td>\n<td>${r.lang}<\/td>\n<td style=\"color:var(--muted)\">${r.updated}<\/td>\n<td><button class=\"btn btn-outline btn-sm\" onclick=\"window.open('${r.url}','_blank')\">View →<\/button><\/td>\n<\/tr>\n`).join('')}\n<\/tbody><\/table>`;\n}\n\n// ===== Render Vercel =====\nfunction renderVercel() {\nconst list = document.getElementById('vercelList');\nlist.innerHTML = `<table class=\"history-table\">\n<thead><tr><th>Project<\/th><th>Framework<\/th><th>URL<\/th><th><\/th><\/tr><\/thead>\n<tbody>\n${SAMPLE_VERCEL.map(v => `\n<tr>\n<td>${v.name}<\/td>\n<td>${v.framework}<\/td>\n<td><a href=\"https://${v.url}\" target=\"_blank\" style=\"color:var(--cyan);text-decoration:none;font-size:12px\">${v.url}<\/a><\/td>\n<td><button class=\"btn btn-outline btn-sm\" onclick=\"window.open('https://${v.url}','_blank')\">Open →<\/button><\/td>\n<\/tr>\n`).join('')}\n<\/tbody><\/table>`;\n}\n\n// ===== Render History =====\nfunction renderHistory(deploys) {\nconst container = document.getElementById('historyContainer');\nif (!deploys || !deploys.length) {\ncontainer.innerHTML = '<p style=\"color:var(--muted);text-align:center;padding:40px\">No deployments yet. Launch your first deployment!<\/p>';\nreturn;\n}\ncontainer.innerHTML = `<table class=\"history-table\">\n<thead><tr>\n<th>Project<\/th><th>Framework<\/th><th>Status<\/th><th>GitHub<\/th><th>Vercel<\/th><th>Live URL<\/th><th>Date<\/th>\n<\/tr><\/thead>\n<tbody>\n${deploys.map(d => `\n<tr>\n<td style=\"font-weight:600\">${d.project}<\/td>\n<td>${d.framework}<\/td>\n<td><span class=\"badge badge-${d.status}\">● ${d.status.charAt(0).toUpperCase()+d.status.slice(1)}<\/span><\/td>\n<td>${d.github === 'pushed' ? '✅' : '⏳'}<\/td>\n<td>${d.vercel === 'ready' ? '✅' : d.vercel === 'building' ? '🔄' : '⏳'}<\/td>\n<td><a href=\"https://${d.url}\" target=\"_blank\" style=\"color:var(--cyan);text-decoration:none;font-size:12px\">${d.url}<\/a><\/td>\n<td style=\"color:var(--muted);font-size:12px\">${d.date}<\/td>\n<\/tr>\n`).join('')}\n<\/tbody><\/table>`;\n}\n\n// ===== Stats =====\nfunction updateStats(deploys) {\nconst live = deploys.filter(d => d.status === 'live').length;\nconst building = deploys.filter(d => d.status === 'building').length;\nconst failed = deploys.filter(d => d.status === 'failed').length;\ndocument.getElementById('statTotal').textContent = deploys.length;\ndocument.getElementById('statLive').textContent = live;\ndocument.getElementById('statBuilding').textContent = building;\ndocument.getElementById('statFailed').textContent = failed;\n}\n\n// ===== Deploy Form =====\nfunction toggleChip(el) {\nel.classList.toggle('active');\n}\n\nfunction getSelectedPlatforms() {\nreturn Array.from(document.querySelectorAll('.chip.active')).map(c => c.dataset.platform);\n}\n\nasync function launchDeploy() {\nconst name = document.getElementById('projName').value.trim();\nconst framework = document.getElementById('projFramework').value;\nconst desc = document.getElementById('projDesc').value.trim();\nconst envVarsRaw = document.getElementById('projEnvVars').value.trim();\nconst isPrivate = document.getElementById('projPrivate').value === 'true';\nconst autoDeploy = document.getElementById('projAutoDeploy').value === 'true';\nconst platforms = getSelectedPlatforms();\n\nif (!name) { showToast('⚠️ Project name is required', 'error'); return; }\nif (!platforms.length) { showToast('⚠️ Select at least one platform', 'error'); return; }\n\nlet envVars = {};\ntry { if (envVarsRaw) envVars = JSON.parse(envVarsRaw); }\ncatch { showToast('⚠️ Invalid JSON in env vars', 'error'); return; }\n\n// Show log section\ndocument.getElementById('deployLogSection').style.display = 'block';\nclearLog();\naddLog('info', '🚀 Starting deployment pipeline...');\naddLog('', `Project: ${name} | Framework: ${framework} | Platforms: ${platforms.join(', ')}`);\n\n// Try API first, fall back to simulation\ntry {\naddLog('info', '📡 Calling DeployForge API...');\n\nconst body = {\nprojectName: name,\nframework,\ndescription: desc,\nenvVars,\nisPrivate,\nautoDeploy,\nplatforms,\n};\n\nlet response;\nif (platforms.includes('github') && platforms.includes('vercel')) {\n// Full pipeline\nresponse = await fetch(`${API_BASE}/api/deployforgeLaunch`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify(body),\n});\n} else if (platforms.includes('github')) {\nresponse = await fetch(`${API_BASE}/api/deployforgeGitHub`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'createRepo', repoName: name, description: desc, isPrivate }),\n});\n} else if (platforms.includes('vercel')) {\nresponse = await fetch(`${API_BASE}/api/deployforgeVercel`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'createProject', projectName: name, framework }),\n});\n}\n\nif (response && response.ok) {\nconst result = await response.json();\naddLog('success', '✅ Deployment successful!');\nif (result.github) addLog('success', `🐙 GitHub: ${result.github.url}`);\nif (result.vercel) addLog('success', `▲ Vercel: ${result.vercel.url}`);\nshowToast('✅ Deployed successfully!', 'success');\n// Add to history\nSAMPLE_DEPLOYS.unshift({\nid: Date.now(),\nproject: name,\nframework,\nstatus: 'live',\ngithub: 'pushed',\nvercel: 'ready',\nurl: `${name}.vercel.app`,\ndate: new Date().toISOString().slice(0, 16).replace('T', ' '),\n});\nupdateStats(SAMPLE_DEPLOYS);\nrenderHistory(SAMPLE_DEPLOYS);\n} else {\nthrow new Error('API not available');\n}\n} catch (err) {\naddLog('error', `⚠️ API unavailable: ${err.message}`);\naddLog('info', '📝 Simulating deployment pipeline...');\n\n// Simulate deployment steps\nconst steps = [\n{ delay: 500, msg: '🔐 Authenticating with GitHub...', type: 'info' },\n{ delay: 800, msg: '🐙 Creating GitHub repository...', type: '' },\n{ delay: 600, msg: '📦 Pushing code to GitHub...', type: '' },\n{ delay: 500, msg: '✅ GitHub: repo created & code pushed', type: 'success' },\n{ delay: 700, msg: '▲ Creating Vercel project...', type: 'info' },\n{ delay: 800, msg: '🔧 Setting environment variables...', type: '' },\n{ delay: 600, msg: '🚀 Triggering Vercel deployment...', type: '' },\n{ delay: 1000, msg: '✅ Vercel: project deployed & live', type: 'success' },\n{ delay: 300, msg: '💾 Saving deployment record...', type: '' },\n{ delay: 200, msg: '🎉 Deployment complete!', type: 'success' },\n];\n\nfor (const step of steps) {\nawait new Promise(r => setTimeout(r, step.delay));\naddLog(step.type, step.msg);\n}\n\naddLog('success', `🌐 Live URL: https://${name}.vercel.app`);\n\n// Add to history\nSAMPLE_DEPLOYS.unshift({\nid: Date.now(),\nproject: name,\nframework,\nstatus: 'live',\ngithub: 'pushed',\nvercel: 'ready',\nurl: `${name}.vercel.app`,\ndate: new Date().toISOString().slice(0, 16).replace('T', ' '),\n});\nupdateStats(SAMPLE_DEPLOYS);\nrenderHistory(SAMPLE_DEPLOYS);\nshowToast('✅ Deployment simulated! (API will be live when deployed)', 'success');\n}\n}\n\n// ===== Logging =====\nfunction addLog(type, msg) {\nconst log = document.getElementById('deployLog');\nconst time = new Date().toLocaleTimeString('en-US', { hour12: false });\nconst entry = document.createElement('div');\nentry.className = `log-entry ${type}`;\nentry.innerHTML = `<span class=\"log-time\">[${time}]<\/span> ${msg}`;\nlog.appendChild(entry);\nlog.scrollTop = log.scrollHeight;\n}\n\nfunction clearLog() {\ndocument.getElementById('deployLog').innerHTML = '';\n}\n\nfunction resetForm() {\ndocument.getElementById('projName').value = '';\ndocument.getElementById('projDesc').value = '';\ndocument.getElementById('projEnvVars').value = '';\ndocument.querySelectorAll('.chip').forEach(c => {\nif (c.dataset.platform === 'github' || c.dataset.platform === 'vercel') {\nc.classList.add('active');\n} else {\nc.classList.remove('active');\n}\n});\n}\n\n// ===== Toast =====\nfunction showToast(msg, type = 'success') {\nconst toast = document.getElementById('toast');\ndocument.getElementById('toastMsg').textContent = msg;\ndocument.getElementById('toastIcon').textContent = type === 'success' ? '✅' : '⚠️';\ntoast.className = 'toast show ' + type;\nsetTimeout(() => toast.classList.remove('show'), 3000);\n}\n\n// ===== Refresh Functions =====\nasync function refreshPlatforms() {\nshowToast('↻ Refreshing platforms...');\nrenderPlatforms();\n}\n\nasync function refreshRepos() {\nshowToast('↻ Refreshing repos...');\ntry {\nconst resp = await fetch(`${API_BASE}/api/deployforgeAdmin`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'stats' }),\n});\nif (resp.ok) {\nconst data = await resp.json();\nif (data.github?.repos?.length) {\nSAMPLE_REPOS = data.github.repos.map(r => ({ name: r.name, lang: r.language || '—', url: r.url, updated: r.updated?.slice(0,10) || '—' }));\nrenderRepos();\nshowToast('✅ Repos refreshed from GitHub!');\nreturn;\n}\n}\n} catch {}\nrenderRepos();\n}\n\nasync function refreshVercel() {\nshowToast('↻ Refreshing Vercel...');\ntry {\nconst resp = await fetch(`${API_BASE}/api/deployforgeAdmin`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'stats' }),\n});\nif (resp.ok) {\nconst data = await resp.json();\nif (data.vercel?.projects?.length) {\nSAMPLE_VERCEL = data.vercel.projects.map(p => ({ name: p.name, framework: p.framework || '—', url: p.url }));\nrenderVercel();\nshowToast('✅ Vercel projects refreshed!');\nreturn;\n}\n}\n} catch {}\nrenderVercel();\n}\n\nasync function refreshHistory() {\nshowToast('↻ Refreshing history...');\ntry {\nconst resp = await fetch(`${API_BASE}/api/deployforgeAdmin`, {\nmethod: 'POST',\nheaders: { 'Content-Type': 'application/json' },\nbody: JSON.stringify({ action: 'list' }),\n});\nif (resp.ok) {\nconst data = await resp.json();\nif (data.tasks?.length) {\nconst mapped = data.tasks.map(t => ({\nid: t.id, project: t.project_name, framework: t.framework,\nstatus: t.deploy_status, github: t.github_status, vercel: t.vercel_status,\nurl: t.live_url || t.vercel_url || '', date: t.created_date?.slice(0,16).replace('T',' ') || '—',\n}));\nrenderHistory(mapped);\nupdateStats(mapped);\nshowToast('✅ History refreshed!');\nreturn;\n}\n}\n} catch {}\nrenderHistory(SAMPLE_DEPLOYS);\nupdateStats(SAMPLE_DEPLOYS);\n}\n\n// ===== Init =====\nrenderPlatforms();\nrenderRepos();\nrenderVercel();\nrenderHistory(SAMPLE_DEPLOYS);\nupdateStats(SAMPLE_DEPLOYS);\n<\/script>\n<\/body>\n<\/html>\n"},{"name":"Harz Commerce Network","domain":"harz-commerce-network.hamzarabiu390.workers.dev","url":"https://harz-commerce-network.hamzarabiu390.workers.dev","status":"live","title":"HARZ Commerce Network 2.0","fetched_at":"2026-10-08T06:49:04Z","size":17559,"html_sha256":"e95685d0f5c1e18cb3f6f1295fd8b5ff533abed0e47bcc71a5f7b33d970458f5","html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#f0f2f5\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"HARZ Commerce Network\">\n<link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<title>HARZ Commerce Network 2.0<\/title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,-apple-system,sans-serif}\nbody{background:#f0f2f5;color:#1a1a2e;padding:env(safe-area-inset-top) 12px env(safe-area-inset-bottom)}\n.hd{padding:16px 0;text-align:center;position:sticky;top:0;background:#f0f2f5;z-index:10;border-bottom:1px solid #e0e0e0}\n.hd h1{font-size:20px;color:#0a7d3c;font-weight:800}\n.hd p{font-size:11px;color:#666;margin-top:2px}\n.hd .badge{display:inline-block;background:#e6f4ea;color:#137333;padding:2px 10px;border-radius:12px;font-size:10px;margin-top:4px}\n.tabs{display:flex;overflow-x:auto;gap:4px;margin:12px 0;background:#fff;border-radius:10px;padding:4px;scrollbar-width:none}\n.tabs::-webkit-scrollbar{display:none}\n.tab{flex:0 0 auto;padding:10px 14px;font-size:12px;color:#666;cursor:pointer;border-radius:8px;white-space:nowrap;transition:all .2s}\n.tab.active{background:#0a7d3c;color:#fff;font-weight:600}\n.panel{display:none}.panel.active{display:block}\n.sec{margin:12px 0}\n.sec h2{font-size:13px;color:#666;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;padding-left:4px}\n.card{background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:14px;margin:6px 0}\n.rev-stream{display:flex;align-items:center;gap:10px;padding:10px;border-bottom:1px solid #f0f0f0}\n.rev-stream:last-child{border-bottom:0}\n.rev-icon{font-size:24px}\n.rev-info{flex:1}\n.rev-name{font-size:13px;font-weight:700;color:#1a1a2e}\n.rev-desc{font-size:10px;color:#666;margin-top:1px}\n.rev-rate{font-size:12px;font-weight:700;color:#0a7d3c;white-space:nowrap}\n.lifecycle{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:10px 0}\n.lc-stage{background:#fff;border-radius:10px;padding:10px 12px;border:1px solid #e0e0e0;flex:0 0 auto;min-width:120px}\n.lc-stage .lc-name{font-size:12px;font-weight:700;color:#1a1a2e}\n.lc-stage .lc-desc{font-size:10px;color:#666;margin-top:2px}\n.lc-stage .lc-rev{font-size:10px;color:#0a7d3c;margin-top:4px;font-weight:600}\n.lc-arrow{color:#ccc;font-size:16px}\n.calc-box{background:#fff;border-radius:12px;padding:16px;margin:8px 0}\n.calc-box input{width:100%;padding:12px;border:1px solid #d0d0d0;border-radius:8px;font-size:14px;margin:4px 0}\n.calc-box label{font-size:11px;color:#666;margin-top:8px;display:block}\n.calc-box button{width:100%;padding:12px;background:#0a7d3c;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;margin-top:8px}\n.result-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;font-size:13px}\n.result-total{display:flex;justify-content:space-between;padding:10px 0;font-size:15px;font-weight:700;color:#0a7d3c;border-top:2px solid #0a7d3c;margin-top:4px}\n.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0}\n.stat-box{background:#fff;border-radius:10px;padding:14px;text-align:center}\n.stat-box .n{font-size:24px;font-weight:800;color:#0a7d3c}\n.stat-box .l{font-size:10px;color:#666;margin-top:2px}\n.flow-diagram{background:#fff;border-radius:12px;padding:14px;margin:6px 0;font-size:12px;line-height:2}\n.flow-step{padding:6px 0;border-bottom:1px solid #f0f0f0}\n.flow-step:last-child{border-bottom:0}\n.flow-rev{float:right;font-size:11px;color:#0a7d3c;font-weight:600}\n.foot{text-align:center;padding:20px 0;font-size:10px;color:#999}\n<\/style>\n<\/head>\n<body>\n<div class=\"hd\">\n<h1>🌐 HARZ Commerce Network 2.0<\/h1>\n<p>Transaction Network Revenue Engine<\/p>\n<span class=\"badge\">10 Revenue Streams<\/span>\n<\/div>\n\n<div class=\"tabs\">\n<div class=\"tab active\" onclick=\"show('overview')\">Overview<\/div>\n<div class=\"tab\" onclick=\"show('streams')\">Revenue Streams<\/div>\n<div class=\"tab\" onclick=\"show('lifecycle')\">Lifecycle<\/div>\n<div class=\"tab\" onclick=\"show('calculator')\">Revenue Calculator<\/div>\n<div class=\"tab\" onclick=\"show('network')\">Network Model<\/div>\n<\/div>\n\n<div id=\"overview\" class=\"panel active\">\n<div class=\"sec\">\n<h2>The Big Shift<\/h2>\n<div class=\"card\">\n<div style=\"font-size:14px;line-height:1.6;color:#1a1a2e\">\n<p style=\"font-weight:700;color:#0a7d3c;margin-bottom:8px\">From SaaS to Transaction Network<\/p>\n<p style=\"margin-bottom:8px\">Old model: Merchant pays ₦10k/month subscription. HARZ earns one revenue stream.<\/p>\n<p style=\"margin-bottom:8px\">New model: Merchant sells ₦10M/month. HARZ earns from <strong>10 revenue streams<\/strong> across the entire transaction lifecycle.<\/p>\n<p style=\"margin-bottom:8px\">One merchant generating ₦500k+ in monthly HARZ revenue, not ₦10k.<\/p>\n<p style=\"margin-bottom:8px;font-size:12px;color:#e65100;background:#fff8e1;padding:8px;border-radius:8px;margin-top:8px\"><b>Important:<\/b> This is a modeled maximum, not guaranteed. Several streams depend on merchants actually using those services, and some percentages may overlap on the same transaction. Real revenue is being measured in the Revenue Experiment.<\/p>\n<\/div>\n<\/div>\n\n<h2>Per-Merchant Revenue Potential<\/h2>\n<div class=\"stat-grid\">\n<div class=\"stat-box\"><div class=\"n\">10<\/div><div class=\"l\">Revenue Streams<\/div><\/div>\n<div class=\"stat-box\"><div class=\"n\">₦500k+<\/div><div class=\"l\">Per Merchant/Month<\/div><\/div>\n<\/div>\n\n<div class=\"card\">\n<div style=\"font-size:13px;line-height:1.5\">\n<p style=\"font-weight:700;margin-bottom:6px\">Example: Merchant selling ₦10M/month<\/p>\n<div class=\"result-row\"><span>💳 Payment processing (1.5%)<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦150,000<\/span><\/div>\n<div class=\"result-row\"><span>🛒 Marketplace commission (5%)<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦500,000<\/span><\/div>\n<div class=\"result-row\"><span>🚚 Delivery margin (8%)<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦64,000<\/span><\/div>\n<div class=\"result-row\"><span>🤖 AI agent fee<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦50,000<\/span><\/div>\n<div class=\"result-row\"><span>📊 SaaS subscription<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦50,000<\/span><\/div>\n<div class=\"result-row\"><span>📢 Advertising (3%)<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦30,000<\/span><\/div>\n<div class=\"result-row\"><span>📝 Ledger fees<\/span><span style=\"font-weight:700;color:#0a7d3c\">₦10,000<\/span><\/div>\n<div class=\"result-total\"><span>Total HARZ Revenue<\/span><span>₦854,000/mo<\/span><\/div>\n<\/div>\n<\/div>\n\n<div class=\"card\">\n<div style=\"font-size:13px;line-height:1.5\">\n<p style=\"font-weight:700;margin-bottom:6px\">At Scale: 1,000 merchants<\/p>\n<p>₦854,000 avg × 1,000 merchants = <strong>₦854M/month<\/strong><\/p>\n<p style=\"margin-top:4px\">₦10.2B/year — from transaction network economics, not SaaS fees.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<div id=\"streams\" class=\"panel\">\n<div class=\"sec\">\n<h2>10 Revenue Streams<\/h2>\n<p style=\"font-size:12px;color:#666;margin-bottom:8px\">Each stream captures value at a different point in the commerce lifecycle.<\/p>\n<div id=\"streams-list\"><\/div>\n<\/div>\n<\/div>\n\n<div id=\"lifecycle\" class=\"panel\">\n<div class=\"sec\">\n<h2>Commerce Lifecycle — Where Revenue is Captured<\/h2>\n<p style=\"font-size:12px;color:#666;margin-bottom:8px\">Every transaction flows through these stages. HARZ captures revenue at each one.<\/p>\n<div id=\"lifecycle-list\"><\/div>\n<\/div>\n<\/div>\n\n<div id=\"calculator\" class=\"panel\">\n<div class=\"sec\">\n<h2>Revenue Calculator<\/h2>\n<div class=\"calc-box\">\n<label>Monthly Transaction Volume (₦)<\/label>\n<input id=\"calc-txn\" type=\"number\" placeholder=\"10000000\" value=\"10000000\">\n<label>Monthly Delivery Cost (₦)<\/label>\n<input id=\"calc-delivery\" type=\"number\" placeholder=\"800000\" value=\"800000\">\n<label>Monthly API Calls<\/label>\n<input id=\"calc-api\" type=\"number\" placeholder=\"1000\" value=\"1000\">\n<button onclick=\"calcRevenue()\">Calculate HARZ Revenue<\/button>\n<\/div>\n<div id=\"calc-result\"><\/div>\n<\/div>\n<\/div>\n\n<div id=\"network\" class=\"panel\">\n<div class=\"sec\">\n<h2>Network Model<\/h2>\n<div class=\"card\">\n<div style=\"font-size:13px;line-height:1.6\">\n<p style=\"font-weight:700;color:#0a7d3c;margin-bottom:8px\">The Transaction Loop<\/p>\n<div class=\"flow-diagram\">\n<div class=\"flow-step\">1. Customer discovers product <span class=\"flow-rev\">→ Advertising revenue<\/span><\/div>\n<div class=\"flow-step\">2. AI recommends & negotiates <span class=\"flow-rev\">→ AI agent fee<\/span><\/div>\n<div class=\"flow-step\">3. AI places order <span class=\"flow-rev\">→ Marketplace commission<\/span><\/div>\n<div class=\"flow-step\">4. Customer pays <span class=\"flow-rev\">→ Payment processing fee<\/span><\/div>\n<div class=\"flow-step\">5. Merchant receives order <span class=\"flow-rev\">→ SaaS subscription<\/span><\/div>\n<div class=\"flow-step\">6. Fulfillment & delivery <span class=\"flow-rev\">→ Delivery margin<\/span><\/div>\n<div class=\"flow-step\">7. Customer confirms receipt <span class=\"flow-rev\">→ Trust score update<\/span><\/div>\n<div class=\"flow-step\">8. Merchant gets paid <span class=\"flow-rev\">→ Settlement fee<\/span><\/div>\n<div class=\"flow-step\">9. Economic Sky records <span class=\"flow-rev\">→ Ledger fee<\/span><\/div>\n<div class=\"flow-step\">10. AI markets merchant <span class=\"flow-rev\">→ Advertising revenue<\/span><\/div>\n<div class=\"flow-step\">11. Customer returns <span class=\"flow-rev\">→ Repeat all streams<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"card\">\n<div style=\"font-size:13px;line-height:1.6\">\n<p style=\"font-weight:700;color:#0a7d3c;margin-bottom:8px\">Why This is Bigger Than SaaS<\/p>\n<p style=\"margin-bottom:6px\">SaaS revenue = fixed subscription × number of users. Linear growth.<\/p>\n<p style=\"margin-bottom:6px\">Transaction network revenue = fee × transaction volume × number of streams. Exponential growth.<\/p>\n<p style=\"margin-bottom:6px\">As merchants sell more, HARZ earns more — without any additional sales effort.<\/p>\n<p style=\"margin-top:8px;font-weight:700\">Revenue grows with economic activity, not with sales team headcount.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"card\">\n<div style=\"font-size:13px;line-height:1.6\">\n<p style=\"font-weight:700;color:#0a7d3c;margin-bottom:8px\">Strategic Priority Ranking<\/p>\n<div class=\"result-row\"><span>1. Transaction network<\/span><span style=\"font-weight:700\">⭐⭐⭐⭐⭐<\/span><\/div>\n<div class=\"result-row\"><span>2. Payments infrastructure<\/span><span style=\"font-weight:700\">⭐⭐⭐⭐⭐<\/span><\/div>\n<div class=\"result-row\"><span>3. Autonomous AI agents<\/span><span style=\"font-weight:700\">⭐⭐⭐⭐⭐<\/span><\/div>\n<div class=\"result-row\"><span>4. Marketplace<\/span><span style=\"font-weight:700\">⭐⭐⭐⭐⭐<\/span><\/div>\n<div class=\"result-row\"><span>5. Logistics<\/span><span style=\"font-weight:700\">⭐⭐⭐⭐<\/span><\/div>\n<div class=\"result-row\"><span>6. Enterprise infrastructure<\/span><span style=\"font-weight:700\">⭐⭐⭐⭐⭐<\/span><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n<div class=\"foot\">HARZ Commerce Network 2.0 | Transaction Network Revenue Engine<\/div>\n\n<script>\nconst STREAMS = {\"payment_processing\":{\"name\":\"Payment Processing\",\"description\":\"Fee on every payment processed through HARZ Pay\",\"rate_type\":\"percentage\",\"rate\":1.5,\"stage\":\"payment\",\"icon\":\"💳\"},\"marketplace_commission\":{\"name\":\"Marketplace Commission\",\"description\":\"Commission on every product sold through HARZ Commerce\",\"rate_type\":\"percentage\",\"rate\":5,\"stage\":\"sale\",\"icon\":\"🛒\"},\"delivery_margin\":{\"name\":\"Delivery Margin\",\"description\":\"Margin on delivery/fulfillment routed through HARZ Logistics\",\"rate_type\":\"percentage\",\"rate\":8,\"stage\":\"delivery\",\"icon\":\"🚚\"},\"ai_agent_fee\":{\"name\":\"AI Agent Fee\",\"description\":\"Fee for autonomous AI sales agent handling conversations\",\"rate_type\":\"per_transaction\",\"rate\":50,\"stage\":\"sale\",\"icon\":\"🤖\"},\"saas_subscription\":{\"name\":\"SaaS Subscription\",\"description\":\"Monthly platform fee for Business OS\",\"rate_type\":\"monthly\",\"rate\":10000,\"stage\":\"subscription\",\"icon\":\"📊\"},\"advertising\":{\"name\":\"Advertising\",\"description\":\"Businesses pay for AI-driven customer acquisition & marketing\",\"rate_type\":\"percentage\",\"rate\":3,\"stage\":\"marketing\",\"icon\":\"📢\"},\"api_usage\":{\"name\":\"API Usage\",\"description\":\"Developers pay for HARZ infrastructure API calls\",\"rate_type\":\"per_call\",\"rate\":0.5,\"stage\":\"api\",\"icon\":\"🔌\"},\"financing_referral\":{\"name\":\"Financing & Referral\",\"description\":\"Commission from partner financing and supplier referrals\",\"rate_type\":\"percentage\",\"rate\":2,\"stage\":\"financing\",\"icon\":\"🏦\"},\"enterprise_contract\":{\"name\":\"Enterprise Contract\",\"description\":\"Annual contracts for large organizations\",\"rate_type\":\"annual\",\"rate\":1000000,\"stage\":\"enterprise\",\"icon\":\"🏢\"},\"ledger_fee\":{\"name\":\"Ledger / Economic Sky\",\"description\":\"Micro-fee for economic ledger recording and trust scoring\",\"rate_type\":\"per_transaction\",\"rate\":10,\"stage\":\"settlement\",\"icon\":\"📝\"}};\nconst LIFECYCLE = [{\"stage\":\"discovery\",\"name\":\"Product Discovery\",\"revenue\":[\"advertising\"],\"desc\":\"Customer discovers product via HARZ\"},{\"stage\":\"sale\",\"name\":\"AI Sale\",\"revenue\":[\"marketplace_commission\",\"ai_agent_fee\"],\"desc\":\"AI agent facilitates the sale\"},{\"stage\":\"payment\",\"name\":\"Payment\",\"revenue\":[\"payment_processing\"],\"desc\":\"Customer pays through HARZ Pay\"},{\"stage\":\"fulfillment\",\"name\":\"Fulfillment\",\"revenue\":[],\"desc\":\"Merchant prepares order\"},{\"stage\":\"delivery\",\"name\":\"Delivery\",\"revenue\":[\"delivery_margin\"],\"desc\":\"Delivery via HARZ Logistics\"},{\"stage\":\"settlement\",\"name\":\"Settlement\",\"revenue\":[\"ledger_fee\"],\"desc\":\"Economic Sky records transaction\"},{\"stage\":\"marketing\",\"name\":\"AI Marketing\",\"revenue\":[\"advertising\"],\"desc\":\"AI automatically markets merchant\"},{\"stage\":\"subscription\",\"name\":\"Platform Fee\",\"revenue\":[\"saas_subscription\"],\"desc\":\"Monthly Business OS subscription\"}];\n\nfunction show(id) {\n  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));\n  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));\n  document.getElementById(id).classList.add('active');\n  event.target.classList.add('active');\n}\n\nfunction renderStreams() {\n  let html='';\n  Object.entries(STREAMS).forEac